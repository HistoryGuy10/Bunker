      mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089","$version":"A"},"$version":"A"},{"name":"Ammo","value":{"$content":true,"$type":"System.Boolean"},"typeHandle":{"Identification":"System.Boolean,
      mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089","$version":"A"},"$version":"A"},{"name":"Deadb","value":{"$content":true,"$type":"System.Boolean"},"typeHandle":{"Identification":"System.Boolean,
      mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089","$version":"A"},"$version":"A"}],"$version":"A"},"$version":"A"},"controlInputDefinitions":[],"controlOutputDefinitions":[],"valueInputDefinitions":[],"valueOutputDefinitions":[],"title":null,"summary":null,"pan":{"x":-747.5644,"y":2393.549},"zoom":0.55,"elements":[{"argumentCount":4,"coroutine":false,"defaultValues":{"target":null,"name":{"$content":"Alert","$type":"System.String"}},"position":{"x":-739.0,"y":-416.0},"guid":"26256633-c079-4b65-acce-e87af6d533ff","$version":"A","$type":"Unity.VisualScripting.CustomEvent","$id":"19"},{"type":"System.String","value":{"$content":"Lexington,
      April 19, 1775\\n\\n\u201cStand your ground! Don\u2019t fire unless fired upon!\u201d","$type":"System.String"},"defaultValues":{},"position":{"x":-1244.0,"y":1935.0},"guid":"d38953d3-bbbb-48cf-bf1b-af4a848598f9","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"21"},{"chainable":false,"parameterNames":["value"],"member":{"name":"SetActive","parameterTypes":["System.Boolean"],"targetType":"UnityEngine.GameObject","targetTypeName":"UnityEngine.GameObject","$version":"A"},"defaultValues":{"target":null,"%value":{"$content":true,"$type":"System.Boolean"}},"position":{"x":463.0,"y":-384.0},"guid":"a091604a-622b-46b0-9f8e-153c1bfac977","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"23"},{"chainable":false,"member":{"name":"timeScale","parameterTypes":null,"targetType":"UnityEngine.Time","targetTypeName":"UnityEngine.Time","$version":"A"},"defaultValues":{"input":{"$content":1.0,"$type":"System.Single"}},"position":{"x":1292.0,"y":-457.0},"guid":"3f2cc46f-e908-4d4c-9908-6bef58fbc3fe","$version":"A","$type":"Unity.VisualScripting.SetMember","$id":"27"},{"type":"System.String","value":{"$content":"A
      shot rings out from somewhere in the green.\\n\\n\\nThe war has begun...\\n\\nNow
      you must fire back!","$type":"System.String"},"defaultValues":{},"position":{"x":-1250.0,"y":2447.0},"guid":"64ab6244-2674-4b03-9112-27ea5e179322","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"30"},{"type":"System.String","value":{"$content":"<b><color=#D6B25E>Commander!</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":-1269.0,"y":1072.0},"guid":"a4b6a59e-9068-4634-9827-65335daa5ef9","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"32"},{"type":"UnityEngine.Vector3","value":{"x":-3.309998,"y":33.93,"z":0.0,"$type":"UnityEngine.Vector3"},"defaultValues":{},"position":{"x":907.0,"y":249.0},"guid":"5851b6c0-6779-4413-aed3-21954660a157","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"34"},{"argumentCount":4,"defaultValues":{"name":{"$content":"Alert","$type":"System.String"},"target":null},"position":{"x":-987.0,"y":2516.0},"guid":"2f20c696-f65e-4232-a400-28e6621e9909","$version":"A","$type":"Unity.VisualScripting.TriggerCustomEvent","$id":"36"},{"argumentCount":1,"coroutine":false,"defaultValues":{"target":null,"name":{"$content":"Health","$type":"System.String"}},"position":{"x":-402.0,"y":1009.0},"guid":"58077ed9-ee5d-4a15-9216-a29027cf54ec","$version":"A","$type":"Unity.VisualScripting.CustomEvent","$id":"38"},{"type":"System.String","value":{"$content":"<b><color=#D6B25E>CAPTAIN
      JOHN PARKER</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":-1243.0,"y":2099.0},"guid":"87b5eb04-5575-4bde-8c27-deb370b70614","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"40"},{"type":"UnityEngine.Vector3","value":{"x":0.0,"y":0.0,"z":0.0,"$type":"UnityEngine.Vector3"},"defaultValues":{},"position":{"x":1451.0,"y":-168.0},"guid":"73b6486b-6630-4f6f-89ad-021795011c7c","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"42"},{"type":"System.String","value":{"$content":"<b><color=#D6B25E>Another
      Redcoat Falls</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":-47.0,"y":3890.0},"guid":"ac652538-72c1-4d94-a82f-df34a091edcc","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"44"},{"type":"System.String","value":{"$content":"<b><color=#D6B25E>Hold
      the Strongpoints</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":860.0,"y":17.0},"guid":"269b70ca-aa1f-4c7e-9def-9bc56417df58","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"46"},{"type":"System.String","value":{"$content":"The
      hill is paid for in blood, Commander, and the British mean to collect it.\\n\\nEnemy
      fire will <b><color=#FF5C5C>drain troop health</color></b> without mercy. As
      health drops, your men will die, and the line will thin until it can no longer
      stand.\\n\\nDo not spend lives carelessly. Every loss makes the next assault
      harder to survive.\\n\\n<b><color=#4CAF50>Watch the green bar</color></b>.
      If too many men fall, this defense dies with them.","$type":"System.String"},"defaultValues":{},"position":{"x":25.0,"y":927.0},"guid":"eeadd366-ce51-419a-a48f-56e011a313b3","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"48"},{"argumentCount":0,"coroutine":false,"defaultValues":{"target":null,"name":{"$content":"Welcome","$type":"System.String"}},"position":{"x":-1514.0,"y":991.0},"guid":"99d4fa02-439c-4013-8a01-e2350ef20bdd","$version":"A","$type":"Unity.VisualScripting.CustomEvent","$id":"50"},{"type":"System.String","value":{"$content":"The
      regulars are marching on Lexington. Our militia is forming now nearby the Green.\\n\\nGive
      the order, and we will take our positions.","$type":"System.String"},"defaultValues":{},"position":{"x":-1270.0,"y":908.0},"guid":"43ef772b-204d-4cb1-810e-5c3e82ab81e9","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"52"},{"argumentCount":4,"defaultValues":{"name":{"$content":"Alert","$type":"System.String"},"target":null},"position":{"x":253.0,"y":2526.0},"guid":"0681fdbb-52af-4655-8e06-f4434f94a0a8","$version":"A","$type":"Unity.VisualScripting.TriggerCustomEvent","$id":"54"},{"defaultValues":{},"position":{"x":-181.0,"y":3816.0},"guid":"d50f4b58-64e9-410e-8439-0ae07bcdfa59","$version":"A","$type":"Unity.VisualScripting.If","$id":"56"},{"defaultValues":{},"position":{"x":-227.0,"y":-79.0},"guid":"3ddf2acb-62f0-4e39-bcf5-6f2c886fb1dc","$version":"A","$type":"Unity.VisualScripting.If","$id":"58"},{"argumentCount":1,"coroutine":false,"defaultValues":{"target":null,"name":{"$content":"DeadB","$type":"System.String"}},"position":{"x":-448.0,"y":3807.0},"guid":"4c8e89e9-6cac-4ee6-a294-76b331070171","$version":"A","$type":"Unity.VisualScripting.CustomEvent","$id":"60"},{"type":"System.String","value":{"$content":"GO
      TO","$type":"System.String"},"defaultValues":{},"position":{"x":-53.0,"y":3564.0},"guid":"08b553cc-8c08-466b-a95c-04e0099f52f6","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"62"},{"argumentCount":4,"defaultValues":{"name":{"$content":"Alert","$type":"System.String"},"target":null},"position":{"x":168.0,"y":-94.0},"guid":"daf4ea78-1897-4964-905d-c3da20081f97","$version":"A","$type":"Unity.VisualScripting.TriggerCustomEvent","$id":"64"},{"defaultValues":{},"position":{"x":-175.0,"y":3387.0},"guid":"fa90bba4-7c48-4d80-8a92-86feb5e4abae","$version":"A","$type":"Unity.VisualScripting.If","$id":"66"},{"numeric":false,"defaultValues":{},"position":{"x":1466.0,"y":-330.0},"guid":"ec9750d8-da21-4d68-903f-18cd1a86f62b","$version":"A","$type":"Unity.VisualScripting.Equal","$id":"68"},{"type":"System.String","value":{"$content":"These
      points are the spine of your defense, Commander. So long as <b><color=#4DA6FF>even
      one remains in your hands</color></b>, the line still stands.\\n\\nIf you <b><color=#4CAF50>defend
      every point</color></b>, you will <b><color=#4CAF50>win the battle</color></b>.\\n\\nBut
      if the British seize <b><color=#FF5C5C>all of them</color></b>, your defense
      will collapse and <b><color=#B22222>the hill will be lost</color></b>.\\n\\nHold
      each position. Yield nothing without cost.","$type":"System.String"},"defaultValues":{},"position":{"x":859.0,"y":-147.0},"guid":"25d9288c-3a0c-43a6-9e00-0dd145dd3f7f","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"70"},{"kind":"Graph","defaultValues":{"name":{"$content":"pos","$type":"System.String"}},"position":{"x":-462.0,"y":-414.0},"guid":"e784748b-d8ed-42c0-9866-28acd42da828","$version":"A","$type":"Unity.VisualScripting.SetVariable","$id":"72"},{"specifyFallback":false,"kind":"Object","defaultValues":{"name":{"$content":"Button","$type":"System.String"},"object":null},"position":{"x":230.0,"y":-528.0},"guid":"1653b8e9-355f-41e4-bb7e-549903313cab","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"74"},{"argumentCount":4,"defaultValues":{"name":{"$content":"Alert","$type":"System.String"},"target":null},"position":{"x":220.0,"y":3372.0},"guid":"000c0018-886a-40b5-856c-ad0b63fcc623","$version":"A","$type":"Unity.VisualScripting.TriggerCustomEvent","$id":"76"},{"specifyFallback":false,"kind":"Graph","defaultValues":{"name":{"$content":"HealthB","$type":"System.String"}},"position":{"x":-196.0,"y":1674.0},"guid":"81a1b928-77c1-4f94-9560-105dbaa0f828","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"78"},{"specifyFallback":false,"kind":"Graph","defaultValues":{"name":{"$content":"Health","$type":"System.String"}},"position":{"x":-161.0,"y":1174.0},"guid":"241b7dc9-d86c-4739-8315-25c07286b78c","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"80"},{"defaultValues":{},"position":{"x":1532.0,"y":-456.0},"guid":"13d65f3b-845b-4f6c-a7d2-83cde52d8649","$version":"A","$type":"Unity.VisualScripting.If","$id":"82"},{"type":"System.String","value":{"$content":"A
      <b><color=#B22222>British unit has been destroyed</color></b>, Commander.\\n\\nTheir
      dead now stain the slope, and your men can see that the enemy is not invincible.\\n\\n<b><color=#4DA6FF>Each
      fallen unit weakens the assault</color></b>, but do not let triumph make you
      careless. More redcoats are still coming.\\n\\n<b>Hold the line.</b> Make every
      British advance pay in blood.","$type":"System.String"},"defaultValues":{},"position":{"x":-50.0,"y":3734.0},"guid":"b3ca6c39-e2fb-47ae-a061-2c5fd993acf1","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"84"},{"type":"System.String","value":{"$content":"GO
      TO","$type":"System.String"},"defaultValues":{},"position":{"x":-59.0,"y":3993.0},"guid":"8108fe86-f171-4a45-9d84-00ce9478bef1","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"86"},{"specifyFallback":false,"kind":"Graph","defaultValues":{"name":{"$content":"Deadb","$type":"System.String"}},"position":{"x":-237.0,"y":3964.0},"guid":"1a058bfa-5d55-4ea7-a26c-591062b0f1fc","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"88"},{"type":"System.String","value":{"$content":"<b><color=#D6B25E>Powder
      Runs Thin</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":-41.0,"y":3461.0},"guid":"3d7297ee-2917-428c-87fa-b7d26e075c69","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"90"},{"argumentCount":4,"defaultValues":{"name":{"$content":"Alert","$type":"System.String"},"target":null},"position":{"x":214.0,"y":3801.0},"guid":"a812403e-438d-467b-98d7-08376a2b8485","$version":"A","$type":"Unity.VisualScripting.TriggerCustomEvent","$id":"92"},{"type":"UnityEngine.Vector3","value":{"x":0.0,"y":0.0,"z":0.0,"$type":"UnityEngine.Vector3"},"defaultValues":{},"position":{"x":-76.0,"y":227.0},"guid":"e2b8bbf1-ab1d-4b64-96dd-5c7ba7ccc294","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"94"},{"chainable":false,"member":{"name":"timeScale","parameterTypes":null,"targetType":"UnityEngine.Time","targetTypeName":"UnityEngine.Time","$version":"A"},"defaultValues":{"input":{"$content":0.0,"$type":"System.Single"}},"position":{"x":696.0,"y":-387.0},"guid":"fa32cd50-4657-4408-a771-a01e4884677e","$version":"A","$type":"Unity.VisualScripting.SetMember","$id":"96"},{"type":"System.String","value":{"$content":"Next","$type":"System.String"},"defaultValues":{},"position":{"x":-1281.0,"y":1175.0},"guid":"d7917b5d-ed96-47c5-8461-803069976d48","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"99"},{"type":"UnityEngine.Vector3","value":{"x":0.0,"y":0.0,"z":0.0,"$type":"UnityEngine.Vector3"},"defaultValues":{},"position":{"x":-1226.0,"y":2331.0},"guid":"13235f38-873a-449d-8186-0910ff2c8fa1","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"101"},{"argumentCount":4,"defaultValues":{"name":{"$content":"Alert","$type":"System.String"},"target":null},"position":{"x":-981.0,"y":2004.0},"guid":"3445fea9-7852-47ea-8c5e-700f4d0834d3","$version":"A","$type":"Unity.VisualScripting.TriggerCustomEvent","$id":"103"},{"type":"System.String","value":{"$content":"<b><color=#D6B25E>BANG</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":-1263.0,"y":2617.0},"guid":"39f88dcf-7a8d-46a6-9ad4-40af3aa16956","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"105"},{"type":"System.String","value":{"$content":"Select
      troops by left clicking on a soldier, then right click a location to move them
      there.","$type":"System.String"},"defaultValues":{},"position":{"x":-1259.0,"y":1406.0},"guid":"c4e5cbd5-c53e-4d1b-a4b8-3c32f6a6f4b6","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"107"},{"type":"System.String","value":{"$content":"<b><color=#D6B25E>Moving
      Troops</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":-1258.0,"y":1570.0},"guid":"eca4709a-ee5b-4ec1-a78f-1d9b975ee8bd","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"109"},{"type":"System.String","value":{"$content":"Though
      the battle has only begun, frightened men are already abandoning the line.\\n\\nBritish
      cannon fire will continue to <b><color=#FF5C5C>drain morale</color></b>. If
      your troops lose <b><color=#FF5C5C>all morale</color></b>, they will <b><color=#B22222>panic,
      break, and flee</color></b>.\\n\\nPull soldiers <b><color=#D6B25E>back from
      the main line</color></b> when needed so they can <b><color=#4DA6FF>recover
      morale</color></b>.\\n\\n<b><color=#4DA6FF>Watch the blue bar</color></b>.
      Once fear spreads, you will not stop it.","$type":"System.String"},"defaultValues":{},"position":{"x":-4.0,"y":379.0},"guid":"ca46c7c5-09cd-4817-a6ee-340b0fe621a4","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"111"},{"type":"UnityEngine.Vector3","value":{"x":0.0,"y":0.0,"z":0.0,"$type":"UnityEngine.Vector3"},"defaultValues":{},"position":{"x":-1262.0,"y":2818.0},"guid":"0e9ffdc0-89f3-47d6-9f5b-8bd2a3a1f729","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"113"},{"type":"System.String","value":{"$content":"Close","$type":"System.String"},"defaultValues":{},"position":{"x":-1270.0,"y":1673.0},"guid":"e5b16f03-bce1-4c39-9316-9766ba93524f","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"115"},{"chainable":false,"parameterNames":["value"],"member":{"name":"SetActive","parameterTypes":["System.Boolean"],"targetType":"UnityEngine.GameObject","targetTypeName":"UnityEngine.GameObject","$version":"A"},"defaultValues":{"target":null,"%value":{"$content":false,"$type":"System.Boolean"}},"position":{"x":-804.0,"y":992.0},"guid":"d218edb0-a997-4380-8345-af4c4528cce6","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"117"},{"argumentCount":0,"coroutine":false,"defaultValues":{"target":null,"name":{"$content":"WelcomeGIF","$type":"System.String"}},"position":{"x":-1532.0,"y":1470.0},"guid":"414242d8-acf9-44ce-a0cb-feccc0cc2adb","$version":"A","$type":"Unity.VisualScripting.CustomEvent","$id":"121"},{"defaultValues":{"seconds":{"$content":5.0,"$type":"System.Single"},"unscaledTime":{"$content":false,"$type":"System.Boolean"}},"position":{"x":632.0,"y":-71.0},"guid":"a3944700-6d52-4a35-8c10-6c0243c93ba7","$version":"A","$type":"Unity.VisualScripting.WaitForSecondsUnit","$id":"123"},{"argumentCount":4,"defaultValues":{"name":{"$content":"Alert","$type":"System.String"},"target":null},"position":{"x":-996.0,"y":1475.0},"guid":"f55420e9-97cf-45b7-9534-99589397a6a6","$version":"A","$type":"Unity.VisualScripting.TriggerCustomEvent","$id":"125"},{"argumentCount":0,"coroutine":false,"defaultValues":{"target":null,"name":{"$content":"HoldFire","$type":"System.String"}},"position":{"x":-1488.0,"y":2018.0},"guid":"17184bb3-0363-4220-99f3-5ad07b6cbadf","$version":"A","$type":"Unity.VisualScripting.CustomEvent","$id":"127"},{"type":"UnityEngine.Vector3","value":{"x":0.0,"y":0.0,"z":0.0,"$type":"UnityEngine.Vector3"},"defaultValues":{},"position":{"x":-1241.0,"y":1802.0},"guid":"0d63df0d-1e5d-4a30-b11a-0c69b79998a3","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"129"},{"type":"System.String","value":{"$content":"GO
      TO","$type":"System.String"},"defaultValues":{},"position":{"x":-12.0,"y":655.0},"guid":"ae6d8072-3fe5-4e51-971e-fa9de849d732","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"131"},{"argumentCount":1,"coroutine":false,"defaultValues":{"target":null,"name":{"$content":"Ammo","$type":"System.String"}},"position":{"x":-442.0,"y":3378.0},"guid":"59145b7b-8552-42eb-98b3-15f8779279ed","$version":"A","$type":"Unity.VisualScripting.CustomEvent","$id":"133"},{"type":"System.String","value":{"$content":"A
      <b>terrible truth</b> is settling over the line, Commander. One of your units
      is <b><color=#FF5C5C>running low on ammunition</color></b>.\\n\\nEach shot
      now carries dread. Every volley spent is one they may need when the British
      are closer and still coming.\\n\\n<b><color=#D6B25E>Do not waste what remains</color></b>.
      Hold fire until the enemy is near enough to pay for every round.\\n\\nWhen
      powder runs thin, men begin to fear what comes <b><color=#B22222>after the
      firing stops</color></b>.","$type":"System.String"},"defaultValues":{},"position":{"x":-44.0,"y":3305.0},"guid":"c737724f-554e-4309-a985-96814577cf15","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"135"},{"type":"System.String","value":{"$content":"The
      British have taken their first losses, and a cry rises from your men: <b><color=#4DA6FF>\u201cHuzzah!\u201d</color></b>\\n\\nFor
      a moment, fear gives way to defiance. The enemy can bleed. The King''s soldiers
      can fall.\\n\\nLet this lift the line, Commander, but do not be fooled. The
      British are still coming, and they will answer blood with more blood.\\n\\nHold
      fast. Your men have seen that the redcoats can die.","$type":"System.String"},"defaultValues":{},"position":{"x":-9.0,"y":1444.0},"guid":"d4150c7d-edcb-4aac-b3b6-91ff2a377621","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"137"},{"type":"System.Boolean","value":{"$content":false,"$type":"System.Boolean"},"defaultValues":{},"position":{"x":421.0,"y":3959.0},"guid":"a753d10b-e176-468e-b6dd-387de7049121","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"139"},{"type":"System.String","value":{"$content":"CLOSE","$type":"System.String"},"defaultValues":{},"position":{"x":-1255.0,"y":2202.0},"guid":"d9557669-96e8-4d53-b4c9-3474ff049940","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"141"},{"defaultValues":{},"position":{"x":-105.0,"y":1026.0},"guid":"750cbc53-e1fa-48e9-84b2-eff975780911","$version":"A","$type":"Unity.VisualScripting.If","$id":"143"},{"type":"System.Boolean","value":{"$content":false,"$type":"System.Boolean"},"defaultValues":{},"position":{"x":427.0,"y":3530.0},"guid":"deda253b-6496-4f59-90b5-73b6523a620e","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"145"},{"argumentCount":4,"defaultValues":{"name":{"$content":"Alert","$type":"System.String"},"target":null},"position":{"x":-1007.0,"y":977.0},"guid":"98753a49-be37-4905-bfdc-18e645495c69","$version":"A","$type":"Unity.VisualScripting.TriggerCustomEvent","$id":"147"},{"type":"System.String","value":{"$content":"Go
      To","$type":"System.String"},"defaultValues":{},"position":{"x":909.0,"y":118.0},"guid":"ea81bcc6-ef9f-4cf7-b892-2dc5995c1c6d","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"149"},{"kind":"Graph","defaultValues":{"name":{"$content":"Ammo","$type":"System.String"}},"position":{"x":426.0,"y":3386.0},"guid":"e7e572b7-b8ad-489a-bfc0-2020526744bf","$version":"A","$type":"Unity.VisualScripting.SetVariable","$id":"151"},{"type":"System.String","value":{"$content":"<b><color=#D6B25E>Men
      Will Fall</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":29.0,"y":1100.0},"guid":"d2e68941-ba27-460e-9460-eaf26bccaae0","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"153"},{"argumentCount":0,"coroutine":false,"defaultValues":{"target":null,"name":{"$content":"Shoot","$type":"System.String"}},"position":{"x":-1494.0,"y":2530.0},"guid":"a8731144-84d9-49d0-9270-40aacec1df67","$version":"A","$type":"Unity.VisualScripting.CustomEvent","$id":"155"},{"chainable":false,"parameterNames":["text"],"member":{"name":"SetText","parameterTypes":["System.String"],"targetType":"TMPTXT","targetTypeName":"TMPTXT","$version":"A"},"defaultValues":{"target":null,"%text":{"$content":"","$type":"System.String"}},"position":{"x":-190.0,"y":-406.0},"guid":"dc9f7d5a-9492-4d45-abfc-03577780f687","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"157"},{"coroutine":false,"defaultValues":{"name":{"$content":"Time","$type":"System.String"}},"position":{"x":1046.0,"y":-454.0},"guid":"816793b3-caad-462d-ad72-75d61860fc6e","$version":"A","$type":"Unity.VisualScripting.BoltUnityEvent","$id":"161"},{"type":"System.String","value":{"$content":"CLOSE","$type":"System.String"},"defaultValues":{},"position":{"x":-1261.0,"y":2714.0},"guid":"85aa9625-5376-458c-845b-05ee949cc740","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"163"},{"type":"System.Boolean","value":{"$content":false,"$type":"System.Boolean"},"defaultValues":{},"position":{"x":497.0,"y":1169.0},"guid":"6f31eccc-b307-411a-a7e7-f54960be8652","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"165"},{"specifyFallback":false,"kind":"Graph","defaultValues":{"name":{"$content":"Ammo","$type":"System.String"}},"position":{"x":-231.0,"y":3535.0},"guid":"55f66247-3c2c-4317-96a2-87542c646cbd","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"167"},{"type":"UnityEngine.Vector3","value":{"x":0.0,"y":0.0,"z":0.0,"$type":"UnityEngine.Vector3"},"defaultVa