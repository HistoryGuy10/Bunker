      <b><color=#B22222>British unit has been destroyed</color></b>, Commander.\\n\\nTheir
      dead now stain the slope, and your men can see that the enemy is not invincible.\\n\\n<b><color=#4DA6FF>Each
      fallen unit weakens the assault</color></b>, but do not let triumph make you
      careless. More redcoats are still coming.\\n\\n<b>Hold the line.</b> Make every
      British advance pay in blood.","$type":"System.String"},"defaultValues":{},"position":{"x":-50.0,"y":3734.0},"guid":"b3ca6c39-e2fb-47ae-a061-2c5fd993acf1","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"479"},{"specifyFallback":false,"kind":"Graph","defaultValues":{"name":{"$content":"Ammo","$type":"System.String"}},"position":{"x":-231.0,"y":3535.0},"guid":"55f66247-3c2c-4317-96a2-87542c646cbd","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"481"},{"chainable":false,"member":{"name":"timeScale","parameterTypes":null,"targetType":"UnityEngine.Time","targetTypeName":"UnityEngine.Time","$version":"A"},"defaultValues":{"input":{"$content":0.0,"$type":"System.Single"}},"position":{"x":696.0,"y":-387.0},"guid":"fa32cd50-4657-4408-a771-a01e4884677e","$version":"A","$type":"Unity.VisualScripting.SetMember","$id":"483"},{"specifyFallback":false,"kind":"Object","defaultValues":{"name":{"$content":"GIF","$type":"System.String"},"object":null},"position":{"x":-1897.0,"y":3147.0},"guid":"394d1a18-193f-4c34-bde4-eb79c54901bf","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"486"},{"specifyFallback":false,"kind":"Object","defaultValues":{"name":{"$content":"GIF","$type":"System.String"},"object":null},"position":{"x":-1888.0,"y":3668.0},"guid":"4f10488e-2828-489e-9d4a-95671105874b","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"488"},{"argumentCount":0,"coroutine":false,"defaultValues":{"target":null,"name":{"$content":"Welcome","$type":"System.String"}},"position":{"x":-2612.0,"y":1245.0},"guid":"99d4fa02-439c-4013-8a01-e2350ef20bdd","$version":"A","$type":"Unity.VisualScripting.CustomEvent","$id":"490"},{"chainable":false,"parameterNames":["value"],"member":{"name":"SetActive","parameterTypes":["System.Boolean"],"targetType":"UnityEngine.GameObject","targetTypeName":"UnityEngine.GameObject","$version":"A"},"defaultValues":{"target":null,"%value":{"$content":true,"$type":"System.Boolean"}},"position":{"x":