      Huzzah!</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":-6.0,"y":1600.0},"guid":"d271f894-45bd-49bf-8d8e-d03ad41f3b88","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"341"},{"type":"System.String","value":{"$content":"<b><color=#D6B25E>The
      Hills</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":-8.0,"y":2615.0},"guid":"f89c7d04-c9e5-4dd3-9a49-dd31e13045bf","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"343"},{"specifyFallback":false,"kind":"Object","defaultValues":{"name":{"$content":"GIF","$type":"System.String"},"object":null},"position":{"x":-3653.0,"y":1607.0},"guid":"371d6cf9-ef2e-472f-bb56-b57add443f6a","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"345"},{"type":"UnityEngine.Vector3","value":{"x":0.0,"y":0.0,"z":0.0,"$type":"UnityEngine.Vector3"},"defaultValues":{},"position":{"x":-4088.0,"y":3079.0},"guid":"b00521a8-f53d-4cdc-b13e-be1d5799b044","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"347"},{"argumentCount":1,"coroutine":false,"defaultValues":{"target":null,"name":{"$content":"Ammo","$type":"System.String"}},"position":{"x":-442.0,"y":3378.0},"guid":"59145b7b-8552-42eb-98b3-15f8779279ed","$version":"A","$type":"Unity.VisualScripting.CustomEvent","$id":"349"},{"chainable":false,"parameterNames":["value"],"member":{"name":"SetActive","parameterTypes":["System.Boolean"],"targetType":"UnityEngine.GameObject","targetTypeName":"UnityEngine.GameObject","$version":"A"},"defaultValues":{"target":null,"%value":{"$content":true,"$type":"System.Boolean"}},"position":{"x":-1728.0,"y":3790.0},"guid":"e8db088e-8b88-49e6-8923-e846d7581061","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"351"},{"type":"System.String","value":{"$content":"Select
      troops by left clicking on a soldier, then right click a location to move them
      there.","$type":"System.String"},"defaultValues":{},"position":{"x":-2357.0,"y":1660.0},"guid":"c4e5cbd5-c53e-4d1b-a4b8-3c32f6a6f4b6","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"355"},{"type":"UnityEngine.Vector3","value":{"x":0.0,"y":0.0,"z":0.0,"$type":"UnityEngine.Vector3"},"defaultValues":{},"position":{"x":-2339.0,"y":2056.0},"guid":"0d63df0d-1e5d-4a30-b11a-0c69b79998a3","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"357"},{"type":"UnityEngine.Vector3","value":{"x":0.0,"y":0.0,"z":0.0,"$type":"UnityEngine.Vector3"},"defaultValues":{},"position":{"x":-76.0,"y":227.0},"guid":"e2b8bbf1-ab1d-4b64-96dd-5c7ba7ccc294","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"359"},{"defaultValues":{},"position":{"x":-181.0,"y":3816.0},"guid":"d50f4b58-64e9-410e-8439-0ae07bcdfa59","$version":"A","$type":"Unity.VisualScripting.If","$id":"361"},{"argumentCount":0,"coroutine":false,"defaultValues":{"target":null,"name":{"$content":"ShootGIF","$type":"System.String"}},"position":{"x":-2591.0,"y":3287.0},"guid":"3a52172f-b8ca-4a58-8a2d-eee061844e5c","$version":"A","$type":"Unity.VisualScripting.CustomEvent","$id":"363"},{"argumentCount":1,"coroutine":false,"defaultValues":{"target":null,"name":{"$content":"HillTop","$type":"System.String"}},"position":{"x":1253.0,"y":3140.0},"guid":"a962359c-303f-47e0-84bb-bdc850e2900a","$version":"A","$type":"Unity.VisualScripting.CustomEvent","$id":"365"},{"argumentCount":1,"coroutine":false,"defaultValues":{"target":null,"name":{"$content":"Morale","$type":"System.String"}},"position":{"x":-431.0,"y":461.0},"guid":"66077ed8-cf57-4d14-be0d-36b54cea3e14","$version":"A","$type":"Unity.VisualScripting.CustomEvent","$id":"367"},{"type":"System.Boolean","value":{"$content":false,"$type":"System.Boolean"},"defaultValues":{},"position":{"x":497.0,"y":1169.0},"guid":"6f31eccc-b307-411a-a7e7-f54960be8652","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"369"},{"type":"System.String","value":{"$content":"The
      hill is paid for in blood, Commander, and the British mean to collect it.\\n\\nEnemy
      fire will <b><color=#FF5C5C>drain troop health</color></b> without mercy. As
      health drops, your men will die, and the line will thin until it can no longer
      stand.\\n\\nDo not spend lives carelessly. Every loss makes the next assault
      harder to survive.\\n\\n<b><color=#4CAF50>Watch the green bar</color></b>.
      If too many men fall, this defense dies with them.","$type":"System.String"},"defaultValues":{},"position":{"x":25.0,"y":927.0},"guid":"eeadd366-ce51-419a-a48f-56e011a313b3","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"371"},{"type":"System.String","value":{"$content":"<b><color=#D6B25E>Shooting</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":-2359.0,"y":3378.0},"guid":"b42cb469-8878-4e62-b817-6b431a644fd1","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"373"},{"type":"UnityEngine.Vector3","value":{"x":-3.309998,"y":33.93,"z":0.0,"$type":"UnityEngine.Vector3"},"defaultValues":{},"position":{"x":907.0,"y":249.0},"guid":"5851b6c0-6779-4413-aed3-21954660a157","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"375"},{"type":"System.String","value":{"$content":"GO
      TO","$type":"System.String"},"defaultValues":{},"position":{"x":17.0,"y":1203.0},"guid":"8fd86bdd-edd9-4b76-8b2a-84e3caa9b6ff","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"377"},{"type":"System.String","value":{"$content":"Next","$type":"System.String"},"defaultValues":{},"position":{"x":-2379.0,"y":1429.0},"guid":"d7917b5d-ed96-47c5-8461-803069976d48","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"379"},{"argumentCount":4,"defaultValues":{"name":{"$content":"Alert","$type":"System.String"},"target":null},"position":{"x":220.0,"y":3372.0},"guid":"000c0018-886a-40b5-856c-ad0b63fcc623","$version":"A","$type":"Unity.VisualScripting.TriggerCustomEvent","$id":"381"},{"type":"System.String","value":{"$content":"Close","$type":"System.String"},"defaultValues":{},"position":{"x":-2358.0,"y":3471.0},"guid":"6016610d-4056-4d2a-a3c0-2404f082673b","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"383"},{"specifyFallback":false,"kind":"Object","defaultValues":{"name":{"$content":"GIF3","$type":"System.String"},"object":null},"position":{"x":-1118.0,"y":4158.0},"guid":"4d554a37-60ab-4b79-abe8-da4e5343b22f","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"385"},{"chainable":false,"parameterNames":["value"],"member":{"name":"SetActive","parameterTypes":["System.Boolean"],"targetType":"UnityEngine.GameObject","targetTypeName":"UnityEngine.GameObject","$version":"A"},"defaultValues":{"target":null,"%value":{"$content":true,"$type":"System.Boolean"}},"position":{"x":-1907.0,"y":4296.0},"guid":"7ebba8c7-a5da-4640-ac60-b8acd51fdff8","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"387"},{"argumentCount":1,"coroutine":false,"defaultValues":{"target":null,"name":{"$content":"DeadB","$type":"System.String"}},"position":{"x":-448.0,"y":3807.0},"guid":"4c8e89e9-6cac-4ee6-a294-76b331070171","$version":"A","$type":"Unity.VisualScripting.CustomEvent","$id":"391"},{"argumentCount":4,"defaultValues":{"name":{"$co