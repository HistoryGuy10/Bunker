      To","$type":"System.String"},"defaultValues":{},"position":{"x":909.0,"y":118.0},"guid":"ea81bcc6-ef9f-4cf7-b892-2dc5995c1c6d","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"403"},{"type":"System.String","value":{"$content":"CLOSE","$type":"System.String"},"defaultValues":{},"position":{"x":-2353.0,"y":2456.0},"guid":"d9557669-96e8-4d53-b4c9-3474ff049940","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"405"},{"type":"System.String","value":{"$content":"<b><color=#D6B25E>Commander!</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":-2367.0,"y":1326.0},"guid":"a4b6a59e-9068-4634-9827-65335daa5ef9","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"407"},{"chainable":false,"parameterNames":["value"],"member":{"name":"SetActive","parameterTypes":["System.Boolean"],"targetType":"UnityEngine.GameObject","targetTypeName":"UnityEngine.GameObject","$version":"A"},"defaultValues":{"target":null,"%value":{"$content":false,"$type":"System.Boolean"}},"position":{"x":-1515.0,"y":4300.0},"guid":"c32daa6e-6704-496e-af06-12767c0de47b","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"409"},{"chainable":false,"parameterNames":["value"],"member":{"name":"SetActive","parameterTypes":["System.Boolean"],"targetType":"UnityEngine.GameObject","targetTypeName":"UnityEngine.GameObject","$version":"A"},"defaultValues":{"target":null,"%value":{"$content":false,"$type":"System.Boolean"}},"position":{"x":-1350.0,"y":4300.0},"guid":"eb8f3791-58f5-442e-bfc9-67a6e7ecdd71","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"413"},{"argumentCount":4,"defaultValues":{"name":{"$content":"Alert","$type":"System.String"},"target":null},"position":{"x":236.0,"y":1973.0},"guid":"b84de2c4-aebf-438d-a4f9-a0faba7254f4","$version":"A","$type":"Unity.VisualScripting.TriggerCustomEvent","$id":"417"},{"type":"System.String","value":{"$content":"<b><color=#D6B25E>BANG!!</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":-2361.0,"y":2871.0},"guid":"39f88dcf-7a8d-46a6-9ad4-40af3aa16956","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"419"},{"argumentCount":0,"coroutine":false,"defaultValues":{"target":null,"name":{"$content":"HoldFire","$type":"System.String"}},"position":{"x":-2586.0,"y":2272.0},"guid":"17184bb3-0363-4220-99f3-5ad07b6cbadf","$version":"A","$type":"Unity.VisualScripting.CustomEvent","$id":"421"},{"argumentCount":4,"defaultValues":{"name":{"$content":"Alert","$type":"System.String"},"target":null},"position":{"x":214.0,"y":3801.0},"guid":"a812403e-438d-467b-98d7-08376a2b8485","$version":"A","$type":"Unity.VisualScripting.TriggerCustomEvent","$id":"423"},{"coroutine":true,"defaultValues":{},"position":{"x":-962.0,"y":-95.0},"guid":"ac332add-68f3-41a1-a681-8a151812c002","$version":"A","$type":"Unity.VisualScripting.Start"},{"chainable":false,"parameterNames":["value"],"member":{"name":"SetActive","parameterTypes":["System.Boolean"],"targetType":"UnityEngine.GameObject","targetTypeName":"UnityEngine.GameObject","$version":"A"},"defaultValues":{"target":null,"%value":{"$content":false,"$type":"System.Boolean"}},"position":{"x":-1730.0,"y":3291.0},"guid":"bf2115d4-0497-4c2b-9f8e-ea9a0a4a9243","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"427"},{"type":"System.String","value":{"$content":"We
      are breaking, sir! If we stay here, the British will tear straight through
      us! Order the retreat before there is nothing left to save!","$type":"System.String"},"defaultValues":{},"position":{"x":-2353.0,"y":3705.0},"guid":"75450c22-4630-4601-aeae-b407a389cf78","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"431"},{"type":"System.String","value":{"$content":"<b><color=#D6B25E>Commander!</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":-4116.0,"y":2349.0},"guid":"fbef485b-8647-4bec-b2e5-e1d3d8b673d5","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"433"},{"type":"System.String","value":{"$content":"Lexington,
      April 19, 1775\\n\\n\u201cStand your ground! Don\u2019t fire unless fired upon!\u201d","$type":"System.String"},"defaultValues":{},"position":{"x":-2342.0,"y":2189.0},"guid":"d38953d3-bbbb-48cf-bf1b-af4a848598f9","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"435"},{"specifyFallback":false,"kind":"Object","defaultValues":{"name":{"$content":"GIF","$type":"System.String"},"object":null},"position":{"x":-1885.0,"y":2149.0},"guid":"5c7a0395-4a3b-4b55-b777-a14e02cdc3fb","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"437"},{"specifyFallback":false,"kind":"Object","defaultValues":{"name":{"$content":"GIF4","$type":"System.String"},"object":null},"position":{"x":-3255.0,"y":2610.0},"guid":"f7af7730-6e14-4658-a20c-09905c1a11e3","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"439"},{"type":"System.String","value":{"$content":"Though
      the battle has only begun, frightened men are already abandoning the line.\\n\\nBritish
      cannon fire will continue to <b><color=#FF5C5C>drain morale</color></b>. If
      your troops lose <b><color=#FF5C5C>all morale</color></b>, they will <b><color=#B22222>panic,
      break, and flee</color></b>.\\n\\nPull soldiers <b><color=#D6B25E>back from
      the main line</color></b> when needed so they can <b><color=#4DA6FF>recover
      morale</color></b>.\\n\\n<b><color=#4DA6FF>Watch the blue bar</color></b>.
      Once fear spreads, you will not stop it.","$type":"System.String"},"defaultValues":{},"position":{"x":-4.0,"y":379.0},"guid":"ca46c7c5-09cd-4817-a6ee-340b0fe621a4","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"441"},{"chainable":false,"parameterNames":["value"],"member":{"name":"SetActive","parameterTypes":["System.Boolean"],"targetType":"UnityEngine.GameObject","targetTypeName":"UnityEngine.GameObject","$version":"A"},"defaultValues":{"target":null,"%value":{"$content":false,"$type":"System.Boolean"}},"position":{"x":-1897.0,"y":2272.0},"guid":"c1419709-7147-488e-ad46-f6d5629fc1cc","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"443"},{"argumentCount":4,"defaultValues":{"name":{"$content":"Alert","$type":"System.String"},"target":null},"position":{"x":-2084.0,"y":3273.0},"guid":"4795804b-ecb1-4d23-8bab-4ed024552866","$version":"A","$type":"Unity.VisualScripting.TriggerCustomEvent","$id":"447"},{"argumentCount":0,"coroutine":false,"defaultValues":{"target":null,"name":{"$content":"Retreat","$type":"System.String"}},"position":{"x":-2597.0,"y":3788.0},"guid":"837062f5-b1b3-48a6-9003-51d7c23dbee3","$version":"A","$type":"Unity.VisualScripting.CustomEvent","$id":"449"},{"chainable":false,"parameterNames":["value"],"member":{"name":"SetActive","parameterTypes":["System.Boolean"],"targetType":"UnityEngine.GameObject","targetTypeName":"UnityEngine.GameObject","$version":"A"},"defaultValues":{"target":null,"%value":{"$content":false,"$type":"System.Boolean"}},"position":{"x":-1895.0,"y":2787.0},"guid":"c50e6dbd-c743-42e2-b60f-7c2ea8bdd2eb","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"451"},{"argumentCount":4,"defaultValues":{"name":{"$content":"Alert","$type":"System.String"},"target":null},"position":{"x":-2085.0,"y":2770.0},"guid":"2f20c696-f65e-4232-a400-28e6621e9909","$version":"A","$type":"Unity.VisualScripting.TriggerCustomEvent","$id":"455"},{"type":"System.Boolean","value":{"$content":false,"$type":"Sys