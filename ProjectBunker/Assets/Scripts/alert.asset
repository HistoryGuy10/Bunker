lues":{"name":{"$content":"TextTitle","$type":"System.String"},"object":null},"position":{"x":16.0,"y":-550.0},"guid":"70b9f67a-bf34-49e6-bdbd-9c5c64eb03e0","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"24"},{"specifyFallback":false,"kind":"Object","defaultValues":{"name":{"$content":"Button","$type":"System.String"},"object":null},"position":{"x":230.0,"y":-528.0},"guid":"1653b8e9-355f-41e4-bb7e-549903313cab","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"26"},{"chainable":false,"member":{"name":"timeScale","parameterTypes":null,"targetType":"UnityEngine.Time","targetTypeName":"UnityEngine.Time","$version":"A"},"defaultValues":{"input":{"$content":1.0,"$type":"System.Single"}},"position":{"x":817.0,"y":-66.0},"guid":"3f2cc46f-e908-4d4c-9908-6bef58fbc3fe","$version":"A","$type":"Unity.VisualScripting.SetMember","$id":"28"},{"type":"System.String","value":{"$content":"Welcome
      to the Colonial","$type":"System.String"},"defaultValues":{},"position":{"x":-95.0,"y":207.0},"guid":"f34eab09-96c2-439c-9be7-26832476c3a9","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"31"},{"coroutine":false,"defaultValues":{},"position":{"x":-476.0,"y":-80.0},"guid":"ac332add-68f3-41a1-a681-8a151812c002","$version":"A","$type":"Unity.VisualScripting.Start","$id":"33"},{"defaultValues":{},"position":{"x":-227.0,"y":-79.0},"guid":"3ddf2acb-62f0-4e39-bcf5-6f2c886fb1dc","$version":"A","$type":"Unity.VisualScripting.If","$id":"35"},{"specifyFallback":false,"kind":"Graph","defaultValues":{"name":{"$content":"Welcome","$type":"System.String"}},"position":{"x":-283.0,"y":69.0},"guid":"d0a25969-a22a-4354-9cac-32fe70ce9f8f","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"37"},{"argumentCount":4,"defaultValues":{"name":{"$content":"Alert","$type":"System.String"},"target":null},"position":{"x":168.0,"y":-94.0},"guid":"daf4ea78-1897-4964-905d-c3da20081f97","$version":"A","$type":"Unity.VisualScripting.TriggerCustomEvent","$id":"39"},{"type":"System.String","value":{"$content":"Through
      the night, your men have <b>raised fresh fortifications</b> atop this hill.
      They are <color=#C9C9C9>rough</color>. They are <color=#C9C9C9>incomplete</color>.
      They are all that stand before the enemy now.\\n\\n<b><color=#B22222>The British
      are coming.</color></b>\\nTheir ranks are trained, their bayonets fixed, and
      their cannon will not spare this ground.\\n\\nYou command a <b><color=#FF5C5C>desperate
      defense</color></b>. <b>Hold the line.</b> Make every shot count.\\n\\nIf they
      take this hill, make them <b><color=#FF3B30>fear the price.</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":-94.0,"y":-169.0},"guid":"d4d7c6b1-f2a3-47cf-95cd-6c480d5b785a","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"41"},{"type":"System.String","value":{"$content":"<b><color=#D6B25E>Welcome,
      Commander!</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":-93.0,"y":-5.0},"guid":"f284df51-0032-491f-be72-75e5fab6e563","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"43"},{"type":"System.String","value":{"$content":"CLOSE","$type":"System.String"},"defaultValues":{},"position":{"x":-105.0,"y":98.0},"guid":"9b598b8b-e6c1-46da-a751-002bf23fb92c","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"45"},{"specifyFallback":false,"kind":"Object","defaultValues":{"name":{"$content":"Panel","$type":"System.String"},"object":null},"position":{"x":462.0,"y":-511.0},"guid":"3521b011-b768-4a78-a27b-f0ec63f80564","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"47"},{"chainable":false,"parameterNames":["text"],"member":{"name":"SetText","parameterTypes":["System.String"],"targetType":"TMPTXT","targetTypeName":"TMPTXT","$version":"A"},"defaultValues":{"target":null,"%text":{"$content":"","$type":"System.String"}},"position":{"x":-190.0,"y":-406.0},"guid":"dc9f7d5a-9492-4d45-abfc-03577780f687","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"49"},{"chainable":false,"parameterNames":["text"],"member":{"name":"SetText","parameterTypes":["System.String"],"targetType":"TMPTXT","targetTypeName":"TMPTXT","$version":"A"},"defaultValues":{"target":null,"%text":{"$content":"","$type":"System.String"}},"position":{"x":18.0,"y":-420.0},"guid":"806d53af-bcc0-4852-ad0e-4d87eb2374d4","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"53"},{"chainable":false,"parameterNames":["text"],"member":{"name":"SetText","parameterTypes":["System.String"],"targetType":"TMPTXT","targetTypeName":"TMPTXT","$version":"A"},"defaultValues":{"target":null,"%text":{"$content":"","$type":"System.String"}},"position":{"x":242.0,"y":-400.0},"guid":"ac0c8b31-2ca1-4261-99b1-f0b3f37d3576","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"57"},{"kind":"Graph","defaultValues":{"name":{"$content":"W