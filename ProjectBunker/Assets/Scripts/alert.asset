ontent":"Panel","$type":"System.String"},"object":null},"position":{"x":462.0,"y":-511.0},"guid":"3521b011-b768-4a78-a27b-f0ec63f80564","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"45"},{"specifyFallback":false,"kind":"Graph","defaultValues":{"name":{"$content":"pos","$type":"System.String"}},"position":{"x":1632.0,"y":-258.0},"guid":"da469f45-d814-450c-b4f8-08bc303a4078","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"47"},{"type":"System.String","value":{"$content":"GO
      TO","$type":"System.String"},"defaultValues":{},"position":{"x":-12.0,"y":655.0},"guid":"ae6d8072-3fe5-4e51-971e-fa9de849d732","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"49"},{"specifyFallback":false,"kind":"Object","defaultValues":{"name":{"$content":"TextMain","$type":"System.String"},"object":null},"position":{"x":-198.0,"y":-586.0},"guid":"496fc1ad-69e2-460b-ab0e-36c7489966d5","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"51"},{"chainable":false,"parameterNames":["value"],"member":{"name":"SetActive","parameterTypes":["System.Boolean"],"targetType":"UnityEngine.GameObject","targetTypeName":"UnityEngine.GameObject","$version":"A"},"defaultValues":{"target":null,"%value":{"$content":true,"$type":"System.Boolean"}},"position":{"x":463.0,"y":-384.0},"guid":"a091604a-622b-46b0-9f8e-153c1bfac977","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"53"},{"chainable":false,"member":{"name":"timeScale","parameterTypes":null,"targetType":"UnityEngine.Time","targetTypeName":"UnityEngine.Time","$version":"A"},"defaultValues":{"input":{"$content":1.0,"$type":"System.Single"}},"position":{"x":1292.0,"y":-457.0},"guid":"3f2cc46f-e908-4d4c-9908-6bef58fbc3fe","$version":"A","$type":"Unity.VisualScripting.SetMember","$id":"57"},{"type":"System.Boolean","value":{"$content":false,"$type":"System.Boolean"},"defaultValues":{},"position":{"x":468.0,"y":621.0},"guid":"7563874e-8726-4183-b07f-692f61264cd9","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"60"},{"defaultValues":{},"position":{"x":-134.0,"y":478.0},"guid":"61c1c303-ba47-45b4-885e-41ab24fbca63","$version":"A","$type":"Unity.VisualScripting.If","$id":"62"},{"type":"System.String","value":{"$content":"These
      points are the spine of your defense, Commander. So long as <b><color=#4DA6FF>even
      one remains in your hands</color></b>, the line still stands.\\n\\nIf you <b><color=#4CAF50>defend
      every point</color></b>, you will <b><color=#4CAF50>win the battle</color></b>.\\n\\nBut
      if the British seize <b><color=#FF5C5C>all of them</color></b>, your defense
      will collapse and <b><color=#B22222>the hill will be lost</color></b>.\\n\\nHold
      each position. Yield nothing without cost.","$type":"System.String"},"defaultValues":{},"position":{"x":859.0,"y":-147.0},"guid":"25d9288c-3a0c-43a6-9e00-0dd145dd3f7f","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"64"},{"type":"System.String","value":{"$content":"<b><color=#D6B25E>Welcome,
      Commander!</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":-93.0,"y":-5.0},"guid":"f284df51-0032-491f-be72-75e5fab6e563","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"66"},{"specifyFallback":false,"kind":"Graph","defaultValues":{"name":{"$content":"Welcome","$type":"System.String"}},"position":{"x":-283.0,"y":69.0},"guid":"d0a25969-a22a-4354-9cac-32fe70ce9f8f","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"68"},{"specifyFallback":false,"kind":"Graph","defaultValues":{"name":{"$content":"pos","$type":"System.String"}},"position":{"x":1165.0,"y":-317.0},"guid":"303b0ac8-cd1e-4046-8ff8-fe66dcc048d8","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"70"},{"specifyFallback":false,"kind":"Graph","defaultValues":{"name":{"$content":"HealthB","$type":"System.String"}},"position":{"x":-196.0,"y":1674.0},"guid":"81a1b928-77c1-4f94-9560-105dbaa0f828","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"72"},{"kind":"Graph","defaultValues":{"name":{"$content":"pos","$type":"System.String"}},"position":{"x":-462.0,"y":-414.0},"guid":"e784748b-d8ed-42c0-9866-28acd42da828","$version":"A","$type":"Unity.VisualScripting.SetVariable","$id":"74"},{"type":"UnityEngine.Vector3","value":{"x":0.0,"y":0.0,"z":0.0,"$type":"UnityEngine.Vector3"},"defaultValues":{},"position":{"x":-76.0,"y":227.0},"guid":"e2b8bbf1-ab1d-4b64-96dd-5c7ba7ccc294","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"76"},{"type":"UnityEngine.Vector3","value":{"x":-3.309998,"y":33.93,"z":0.0,"$type":"UnityEngine.Vector3"},"defaultValues":{},"position":{"x":907.0,"y":249.0},"guid":"5851b6c0-6779-4413-aed3-21954660a157","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"78"},{"chainable":false,"member":{"name":"timeScale","parameterTypes":null,"targetType":"UnityEngine.Time","targetTypeName":"UnityEngine.Time","$version":"A"},"defaultValues":{"input":{"$content":0.0,"$type":"System.Single"}},"position":{"x":696.0,"y":-387.0},"guid":"fa32cd50-4657-4408-a771-a01e4884677e","$version":"A","$type":"Unity.VisualScripting.SetMember","$id":"80"},{"specifyFallback":false,"kind":"Graph","defaultValues":{"name":{"$content":"Ammo","$type":"System.String"}},"position":{"x":-231.0,"y":3535.0},"guid":"55f66247-3c2c-4317-96a2-87542c646cbd","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"83"},{"kind":"Graph","defaultValues":{"name":{"$content":"Deadb","$type":"System.String"}},"position":{"x":420.0,"y":3815.0},"guid":"b01fe4db-0bfb-4e81-81cd-0a3f02572b61","$version":"A","$type":"Unity.VisualScripting.SetVariable","$id":"85"},{"type":"System.Boolean","value":{"$content":false,"$type":"System.Boolean"},"defaultValues":{},"position":{"x":497.0,"y":1169.0},"guid":"6f31eccc-b307-411a-a7e7-f54960be8652","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"87"},{"type":"System.String","value":{"$content":"<b><color=#D6B25E>Another
      Redcoat Falls</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":-47.0,"y":3890.0},"guid":"ac652538-72c1-4d94-a82f-df34a091edcc","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"89"},{"defaultValues":{},"position":{"x":-105.0,"y":1026.0},"guid":"750cbc53-e1fa-48e9-84b2-eff975780911","$version":"A","$type":"Unity.VisualScripting.If","$id":"91"},{"type":"System.Boolean","value":{"$content":false,"$type":"System.Boolean"},"defaultValues":{},"position":{"x":421.0,"y":3959.0},"guid":"a753d10b-e176-468e-b6dd-387de7049121","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"93"},{"type":"System.String","value":{"$content":"A
      <b><color=#B22222>British unit has been destroyed</color></b>, Commander.\\n\\nTheir
      dead now stain the slope, and your men can see that the enemy is not invincible.\\n\\n<b><color=#4DA6FF>Each
      fallen unit weakens the assault</color></b>, but do not let triumph make you
      careless. More redcoats are still coming.\\n\\n<b>Hold the line.</b> Make every
      British advance pay in blood.","$type":"System.String"},"defaultValues":{},"position":{"x":-50.0,"y":3734.0},"guid":"b3ca6c39-e2fb-47ae-a061-2c5fd993acf1","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"95"},{"type":"System.String","value":{"$content":"The
      British have taken their first losses, and a cry rises from your men: <b><color=#4DA6FF>\u201cHuzzah!\u201d</color></b>\\n\\nFor
      a moment, fear gives way to defiance. The enemy can bleed. The King''s soldiers
      can fall.\\n\\nLet this lift the line, Commander, but do not be fooled. The
      British are still coming, and they will answer blood with more blood.\\n\\nHold
      fast. Your men have seen that the redcoats can die.","$type":"System.String"},"defaultValues":{},"position":{"x":-9.0,"y":1444.0},"guid":"d4150c7d-edcb-4aac-b3b6-91ff2a377621","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"97"},{"type":"System.String","value":{"$content":"Though
      the battle has only begun, frightened men are already abandoning the line.\\n\\nBritish
      cannon fire will continue to <b><color=#FF5C5C>drain morale</color></b>. If
      your troops lose <b><color=#FF5C5C>all morale</color></b>, they will <b><color=#B22222>panic,
      break, and flee</color></b>.\\n\\nPull soldiers <b><color=#D6B25E>back from
      the main line</color></b> when needed so they can <b><color=#4DA6FF>recover
      morale</color></b>.\\n\\n<b><color=#4DA6FF>Watch the blue bar</color></b>.
      Once fear spreads, you will not stop it.","$type":"System.String"},"defaultValues":{},"position":{"x":-4.0,"y":379.0},"guid":"ca46c7c5-09cd-4817-a6ee-340b0fe621a4","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"99"},{"type":"System.String","value":{"$content":"<b><color=#D6B25E>Men
      Will Fall</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":29.0,"y":1100.0},"guid":"d2e68941-ba27-460e-9460-eaf26bccaae0","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"101"},{"type":"System.String","value":{"$content":"GO
      TO","$type":"System.String"},"defaultValues":{},"position":{"x":-59.0,"y":3993.0},"guid":"8108fe86-f171-4a45-9d84-00ce9478bef1","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"103"},{"defaultValues":{},"position":{"x":-175.0,"y":3387.0},"guid":"fa90bba4-7c48-4d80-8a92-86feb5e4abae","$version":"A","$type":"Unity.VisualScripting.If","$id":"105"},{"type":"System.String","value":{"$content":"<b><color=#D6B25E>Powder
      Runs Thin</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":-41.0,"y":3461.0},"guid":"3d7297ee-2917-428c-87fa-b7d26e075c69","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"107"},{"argumentCount":4,"defaultValues":{"name":{"$content":"Alert","$type":"System.String"},"target":null},"position":{"x":220.0,"y":3372.0},"guid":"000c0018-886a-40b5-856c-ad0b63fcc623","$version":"A","$type":"Unity.VisualScripting.TriggerCustomEvent","$id":"109"},{"kind":"Graph","defaultValues":{"name":{"$content":"Ammo","$type":"System.String"}},"position":{"x":426.0,"y":3386.0},"guid":"e7e572b7-b8ad-489a-bfc0-2020526744bf","$version":"A","$type":"Unity.VisualScripting.SetVariable","$id":"111"},{"argumentCount":1,"coroutine":false,"defaultValues":{"target":null,"name":{"$content":"Ammo","$type":"System.String"}},"position":{"x":-442.0,"y":3378.0},"guid":"59145b7b-8552-42eb-98b3-15f8779279ed","$version":"A","$type":"Unity.VisualScripting.CustomEvent","$id":"113"},{"type":"System.Boolean","value":{"$content":false,"$type":"System.Boolean"},"defaultValues":{},"position":{"x":427.0,"y":3530.0},"guid":"deda253b-6496-4f59-90b5-73b6523a620e","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"115"},{"type":"System.String","value":{"$content":"A
      <b>terrible truth</b> is settling over the line, Commander. One of your units
      is <b><color=#FF5C5C>running low on ammunition</color></b>.\\n\\nEach shot
      now carries dread. Every volley spent is one they may need when the British
      are closer and still coming.\\n\\n<b><color=#D6B25E>Do not waste what remains</color></b>.
      Hold fire until the enemy is near enough to pay for every round.\\n\\nWhen
      powder runs thin, men begin to fear what comes <b><color=#B22222>after the
      firing stops</color></b>.","$type":"System.String"},"defaultValues":{},"position":{"x":-44.0,"y":3305.0},"guid":"c737724f-554e-4309-a985-96814577cf15","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"117"},{"type":"System.String","value":{"$content":"Go
      To","$type":"System.String"},"defaultValues":{},"position":{"x":909.0,"y":118.0},"guid":"ea81bcc6-ef9f-4cf7-b892-2dc5995c1c6d","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"119"},{"argumentCount":1,"coroutine":false,"defaultValues":{"target":null,"name":{"$content":"Health","$type":"System.String"}},"position":{"x":-402.0,"y":1009.0},"guid":"58077ed9-ee5d-4a15-9216-a29027cf54ec","$version":"A","$type":"Unity.VisualScripting.CustomEvent","$id":"121"},{"type":"UnityEngine.Vector3","value":{"x":0.0,"y":0.0,"z":0.0,"$type":"UnityEngine.Vector3"},"defaultValues":{},"position":{"x":1451.0,"y":-168.0},"guid":"73b6486b-6630-4f6f-89ad-021795011c7c","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"123"},{"type":"System.String","value":{"$content":"<b><color=#D6B25E>Hold
      the Strongpoints</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":860.0,"y":17.0},"guid":"269b70ca-aa1f-4c7e-9def-9bc56417df58","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"125"},{"chainable":false,"parameterNames":["text"],"member":{"name":"SetText","parameterTypes":["System.String"],"targetType":"TMPTXT","targetTypeName":"TMPTXT","$version":"A"},"defaultValues":{"target":null,"%text":{"$content":"","$type":"System.String"}},"position":{"x":-190.0,"y":-406.0},"guid":"dc9f7d5a-9492-4d45-abfc-03577780f687","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"127"},{"specifyFallback":false,"kind":"Object","defaultValues":{"name":{"$content":"Button","$type":"System.String"},"object":null},"position":{"x":230.0,"y":-528.0},"guid":"1653b8e9-355f-41e4-bb7e-549903313cab","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"131"},{"type":"System.String","value":{"$content":"The
      hill is paid for in blood, Commander, and the British mean to collect it.\\n\\nEnemy
      fire will <b><color=#FF5C5C>drain troop health</color></b> without mercy. As
      health drops, your men will die, and the line will thin until it can no longer
      stand.\\n\\nDo not spend lives carelessly. Every loss makes the next assault
      harder to survive.\\n\\n<b><color=#4CAF50>Watch the green bar</color></b>.
      If too many men fall, this defense dies with them.","$type":"System.String"},"defaultValues":{},"position":{"x":25.0,"y":927.0},"guid":"eeadd366-ce51-419a-a48f-56e011a313b3","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"133"},{"defaultValues":{},"position":{"x":-227.0,"y":-79.0},"guid":"3ddf2acb-62f0-4e39-bcf5-6f2c886fb1dc","$version":"A","$type":"Unity.VisualScripting.If","$id":"135"},{"argumentCount":4,"defaultValues":{"name":{"$content":"Alert","$type":"System.String"},"target":null},"position":{"x":290.0,"y":1011.0},"guid":"341220ee-73c8-4f95-819c-c7c096af90da","$version":"A","$type":"Unity.VisualScripting.TriggerCustomEvent","$id":"137"},{"argumentCount":4,"defaultValues":{"name":{"$content":"Alert","$type":"System.String"},"target":null},"position":{"x":236.0,"y":1973.0},"guid":"b84de2c4-aebf-438d-a4f9-a0faba7254f4","$version":"A","$type":"Unity.VisualScripting.TriggerCustomEvent","$id":"139"},{"defaultValues":{},"position":{"x":-159.0,"y":1988.0},"guid":"74855602-97fa-4d5d-a438-c6b3aa06b59d","$version":"A","$type":"Unity.VisualScripting.If","$id":"141"},{"specifyFallback":false,"kind":"Object","defaultValues":{"name":{"$content":"TextTitle","$type":"System.String"},"object":null},"position":{"x":16.0,"y":-550.0},"guid":"70b9f67a-bf34-49e6-bdbd-9c5c64eb03e0","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"143"},{"type":"System.Boolean","value":{"$content":false,"$type":"System.Boolean"},"defaultValues":{},"position":{"x":443.0,"y":2131.0},"guid":"cf58f438-8dee-4dbc-8fdc-98a8e7dd1987","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"145"},{"kind":"Graph","defaultValues":{"name":{"$content":"Welcome","$type":"System.String"}},"position":{"x":374.0,"y":-80.0},"guid":"122b4564-877a-4a2e-96b0-0b96d84a9075","$version":"A","$type":"Unity.VisualScripting.SetVariable","$id":"147"},{"type":"System.String","value":{"$content":"<b><color=#D6B25E>Hip,
      Huzzah!</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":-6.0,"y":1600.0},"guid":"d271f894-45bd-49bf-8d8e-d03ad41f3b88","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"149"},{"argumentCount":1,"coroutine":false,"defaultValues":{"target":null,"name":{"$content":"HealthB","$type":"System.String"}},"position":{"x":-437.0,"y":1509.0},"guid":"08ae7170-c309-4471-9df7-95e2b41791cc","$version":"A","$type":"Unity.VisualScripting.CustomEvent","$id":"151"},{"argumentCount":4,"defaultValues":{"name":{"$content":"Alert","$type":"System.String"},"target":null},"position":{"x":255.0,"y":1511.0},"guid":"607f3427-53bd-4b1f-a07a-acbbe9de8f9d","$version":"A","$type":"Unity.VisualScripting.TriggerCustomEvent","$id":"153"},{"type":"UnityEngine.Vector3","value":{"x":143.45,"y":-32.0,"z":0.0,"$type":"UnityEngine.Vector3"},"defaultValues":{},"position":{"x":222.0,"y":2239.0},"guid":"c4394515-6818-4e46-8833-3b952395c088","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"155"},{"argumentCount":4,"defaultValues":{"name":{"$content":"Alert","$type":"System.String"},"target":null},"position":{"x":240.0,"y":2936.0},"guid":"e7879819-0d91-4735-8eb5-1d4ab70c0faf","$version":"A","$type":"Unity.VisualScripting.TriggerCustomEvent","$id":"157"},{"type":"System.String","value":{"$content":"<b><color=#D6B25E>Command
      Your Men</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":-21.0,"y":3025.0},"guid":"07a9b6e7-9c08-4d88-9bd9-067edec64562","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"159"},{"type":"System.String","value":{"$content":"<b><color=#D6B25E>Fear
      in the Ranks</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":0.0,"y":552.0},"guid":"ab024443-3895-416e-b5ae-f1989dd81123","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"161"},{"type":"System.String","value":{"$content":"GO
      TO","$type":"System.String"},"defaultValues":{},"position":{"x":17.0,"y":1203.0},"guid":"8fd86bdd-edd9-4b76-8b2a-84e3caa9b6ff","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"163"},{"kind":"Graph","defaultValues":{"name":{"$content":"Health","$type":"System.String"}},"position":{"x":496.0,"y":1025.0},"guid":"7aaf2f25-12a1-4908-ad42-a5c5aa1ebb5d","$version":"A","$type":"Unity.VisualScripting.SetVariable","$id":"165"},{"argumentCount":4,"defaultValues":{"name":{"$content":"Alert","$type":"System.String"},"target":null},"position":{"x":253.0,"y":2526.0},"guid":"0681fdbb-52af-4655-8e06-f4434f94a0a8","$version":"A","$type":"Unity.VisualScripting.TriggerCustomEvent","$id":"167"},{"specifyFallback":false,"kind":"Graph","defaultValues":{"name":{"$content":"Hill","$type":"System.String"}},"position":{"x":-198.0,"y":2689.0},"guid":"9f53d213-29c0-49da-a173-57f96a3007d3","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"169"},{"type":"System.String","value":{"$content":"You
      have selected a <b><color=#4DA6FF>player unit</color></b>, Commander.\\n\\nPress
      <b><color=#D6B25E>Q</color></b> to <b><color=#C9C9C9>disengage</color></b>
      and pull the unit out of combat.\\nPress <b><color=#D6B25E>E</color></b> to
      <b><color=#FF5C5C>engage</color></b> the enemy.\\nPress <b><color=#D6B25E>1</color></b>,
      <b><color=#D6B25E>2</color></b>, or <b><color=#D6B25E>3</color></b> to set
      firing range to <b><color=#4CAF50>Low</color></b>, <b><color=#4DA6FF>Medium</color></b>,
      or <b><color=#B22222>Far</color></b>.\\nUse <b><color=#D6B25E>Right Click</color></b>
      to <b>move</b> the unit.\\n\\n<b><color=#FF5C5C>The longer the range, the less
      damage your shots will do.</color></b>\\n\\nCommand carefully. A well-placed
      unit can hold the line. A poorly handled one will die for little.","$type":"System.String"},"defaultValues":{},"position":{"x":-24.0,"y":2869.0},"guid":"43cb68b5-36dc-4cbe-899a-84e38bcdc516","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"171"},{"type":"System.Boolean","value":{"$content":false,"$type":"System.Boolean"},"defaultValues":{},"position":{"x":460.0,"y":2684.0},"guid":"b3da7c9c-9351-417e-be3b-4d8ac4dc513d","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"173"},{"argumentCount":1,"coroutine":false,"defaultValues":{"target":null,"name":{"$content":"Hill","$type":"System.String"}},"position":{"x":-409.0,"y":2532.0},"guid":"10c5c191-eef8-487a-a5a9-d2495d9f0ae0","$version":"A","$type":"Unity.VisualScripting.CustomEvent","$id":"175"},{"kind":"Graph","defaultValues":{"name":{"$content":"Click","$type":"System.String"}},"position":{"x":446.0,"y":2950.0},"guid":"e584b9af-4a98-42df-8cfa-668afcdb0092","$version":"A","$type":"Unity.VisualScripting.SetVariable","$id":"177"},{"type":"System.String","value":{"$content":"GO
      TO","$type":"System.String"},"defaultValues":{},"position":{"x":-37.0,"y":2165.0},"guid":"4c14cfb5-35dd-4af5-ae05-1036e86842fd","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"179"},{"chainable":false,"parameterNames":["text"],"member":{"name":"SetText","parameterTypes":["System.String"],"targetType":"TMPTXT","targetTypeName":"TMPTXT","$version":"A"},"defaultValues":{"target":null,"%text":{"$content":"","$type":"System.String"}},"position":{"x":18.0,"y":-420.0},"guid":"806d53af-bcc0-4852-ad0e-4d87eb2374d4","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"181"},{"chainable":false,"parameterNames":["text"],"member":{"name":"SetText","parameterTypes":["System.String"],"targetType":"TMPTXT","targetTypeName":"TMPTXT","$version":"A"},"defaultValues":{"target":null,"%text":{"$content":"","$type":"System.String"}},"position":{"x":242.0,"y":-400.0},"guid":"ac0c8b31-2ca1-4261-99b1-f0b3f37d3576","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"185"},{"type":"System.String","value":{"$content":"The
      <b><color=#B22222>first British wave</color></b> is upon you, Commander. Their
      line advances through smoke and thunder, and the hill trembles beneath their
      approach.\\n\\nIf they <b><color=#FF5C5C>break through here</color></b>, fear
      will spread fast. If you <b><color=#4CAF50>throw them back</color></b>, your
      men may yet believe this line can hold.\\n\\n<b><color=#D6B25E>Stand firm</color></b>.
      Meet them with <b><color=#4DA6FF>disciplined fire</color></b>, and make the
      <b><color=#FF5C5C>first assault a costly one</color></b>.\\n\\n<b><color=#C9C9C9>This
      is only the beginning.</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":-28.0,"y":1906.0},"guid":"88f6a051-3e47-40a4-a849-bd4d5721d085","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"189"},{"kind":"Graph","defaultValues":{"name":{"$content":"HealthB","$type":"System.String"}},"position":{"x":461.0,"y":1525.0},"guid":"7caf491b-9901-4e4e-b6f2-4b4ed3a115a4","$version":"A","$type":"Unity.VisualScripting.SetVariable","$id":"191"},{"specifyFallback":false,"kind":"Graph","defaultValues":{"name":{"$content":"Morale","$type":"System.String"}},"position":{"x":-190.0,"y":626.0},"guid":"a8c4ddaf-a85b-4d6a-8eba-d456a6d717ef","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"193"},{"argumentCount":4,"defaultValues":{"name":{"$content":"Alert","$type":"System.String"},"target":null},"position":{"x":1155.0,"y":-78.0},"guid":"3d8d5eaa-c84b-4cfc-a57f-7a23d115e5f6","$version":"A","$type":"Unity.VisualScripting.TriggerCustomEvent","$id":"195"},{"coroutine":true,"defaultValues":{},"position":{"x":-962.0,"y":-95.0},"guid":"ac332add-68f3-41a1-a681-8a151812c002","$version":"A","$type":"Unity.VisualScripting.Start"},{"specifyFallback":false,"kind":"Scene","defaultValues":{"name":{"$content":"cam","$type":"System.String"}},"position":{"x":1775.0,"y":-223.0},"guid":"8e543c5f-193f-4003-a539-43587b4396a5","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"199"},{"argumentCount":1,"defaultValues":{"name":{"$content":"GoTo","$type":"System.String"},"target":null},"position":{"x":1806.0,"y":-445.0},"guid":"b8096790-d35e-43da-8ae6-f5bd0db5a395","$version":"A","$type":"Unity.VisualScripting.TriggerCustomEvent","$id":"201"},{"type":"System.Boolean","value":{"$content":false,"$type":"System.Boolean"},"defaultValues":{},"position":{"x":462.0,"y":1669.0},"guid":"3f5d215c-77c0-4fe3-ae37-a2dff02500eb","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"203"},{"specifyFallback":false,"kind":"Graph","defaultValues":{"name":{"$content":"Click","$type":"System.String"}},"position":{"x":-211.0,"y":3099.0},"guid":"4b6a220e-1934-47f4-831e-677c9e162872","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"205"},{"type":"System.String","value":{"$content":"GO
      TO","$type":"System.String"},"defaultValues":{},"position":{"x":-20.0,"y":2718.0},"guid":"a9f7d424-2b99-4b53-8953-c814f172e7a4","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"207"},{"kind":"Graph","defaultValues":{"name":{"$content":"Morale","$type":"System.String"}},"position":{"x":467.0,"y":477.0},"guid":"f2c71b84-ed7d-465f-9f23-a9f87c2262d1","$version":"A","$type":"Unity.VisualScripting.SetVariable","$id":"209"},{"defaultValues":{},"position":{"x":-140.0,"y":1526.0},"guid":"35847866-50cb-4263-af40-de6b1028e41c","$version":"A","$type":"Unity.VisualScripting.If","$id":"211"},{"type":"System.String","value":{"$content":"<b><color=#D6B25E>The
      First Wave</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":-25.0,"y":2062.0},"guid":"5d414fe5-0705-4ffb-860e-17c8f17da4f8","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"213"},{"kind":"Graph","defaultValues":{"name":{"$content":"Wave1","$type":"System.String"}},"position":{"x":442.0,"y":1987.0},"guid":"5e238990-67d1-4951-bd83-bb15d930ae79","$version":"A","$type":"Unity.VisualScripting.SetVariable","$id":"215"},{"specifyFallback":false,"kind":"Graph","defaultValues":{"name":{"$content":"Wave1","$type":"System.String"}},"position":{"x":-215.0,"y":2136.0},"guid":"5d9b78f7-5591-4db4-95ce-6617c34c2b13","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"217"},{"type":"System.Boolean","value":{"$content":false,"$type":"System.Boolean"},"defaultValues":{},"position":{"x":447.0,"y":3094.0},"guid":"697a3267-1794-4ca1-b170-cb5f4587018a","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"219"},{"type":"System.String","value":{"$content":"The
      <b><color=#B22222>British are climbing Bunker Hill</color></b> for the first
      time, Commander. On the slope, they are <b><color=#C9C9C9>exposed</color></b>,
      <b><color=#C9C9C9>slowed</color></b>, and easy targets.\\n\\nAs they advance
      uphill, they will take <b><color=#FF5C5C>much greater damage</color></b> under
      your fire.\\n\\n<b><color=#D6B25E>Use the high ground</color></b>. Let them
      climb into range, then <b><color=#FF5C5C>make them pay for every step</color></b>
      before they reach your line.\\n\\nWhile they fight uphill, <b><color=#4DA6FF>the
      hill is your ally</color></b>.","$type":"System.String"},"defaultValues":{},"position":{"x":-11.0,"y":2459.0},"guid":"a59b8c9e-736c-45b7-bed8-eabc82ee4f3e","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"221"},{"defaultValues":{},"position":{"x":-155.0,"y":2951.0},"guid":"087fae31-a48b-418e-bc85-ff5e6e4584ec","$version":"A","$type":"Unity.VisualScripting.If","$id":"223"},{"argumentCount":0,"coroutine":false,"defaultValues":{"target":null,"name":{"$content":"Wave1","$type":"System.String"}},"position":{"x":-426.0,"y":1979.0},"guid":"a47a86cd-6bc5-41f9-a38f-2582e8d00de0","$version":"A","$type":"Unity.VisualScripting.CustomEvent","$id":"225"},{"defaultValues":{},"position":{"x":-142.0,"y":2541.0},"guid":"990a4f7d-25c4-4924-9d2d-f31fd86344df","$version":"A","$type":"Unity.VisualScripting.If","$id":"227"},{"type":"System.String","value":{"$content":"<b><color=#D6B25E>The
      Bunker Hill</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":-8.0,"y":2615.0},"guid":"f89c7d04-c9e5-4dd3-9a49-dd31e13045bf","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"229"},{"type":"System.Boolean","value":{"$content":false,"$type":"System.Boolean"},"defaultValues":{},"position":{"x":375.0,"y":64.0},"guid":"54efba63-b899-42e5-9050-d3410d8cf861","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"231"},{"kind":"Graph","defaultValues":{"name":{"$content":"Hill","$type":"System.String"}},"position":{"x":459.0,"y":2540.0},"guid":"d6a830c8-cc23-44d6-89de-51de184644c1","$version":"A","$type":"Unity.VisualScripting.SetVariable","$id":"233"},{"argumentCount":1,"coroutine":false,"defaultValues":{"target":null,"name":{"$content":"Morale","$type":"System.String"}},"position":{"x":-431.0,"y":461.0},"guid":"66077ed8-cf57-4d14-be0d-36b54cea3e14","$version":"A","$type":"Unity.VisualScripting.CustomEvent","$id":"235"},{"type":"System.String","value":{"$content":"GO
      TO","$type":"System.String"},"defaultValues":{},"position":{"x":-33.0,"y":3128.0},"guid":"34755d2d-b829-4b2f-a8d9-4c243be630b0","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"237"},{"argumentCount":1,"coroutine":false,"defaultValues":{"target":null,"name":{"$content":"Click","$type":"System.String"}},"position":{"x":-422.0,"y":2942.0},"guid":"bd3ac7c5-d422-4cb8-a568-f25813120cc1","$version":"A","$type":"Unity.VisualScripting.CustomEvent","$id":"239"},{"argumentCount":4,"defaultValues":{"name":{"$content":"Alert","$type":"System.String"},"target":null},"position":{"x":261.0,"y":463.0},"guid":"e10fe2bf-2623-4145-8f18-875f8da14a42","$version":"A","$type":"Unity.VisualScripting.TriggerCustomEvent","$id":"241"},{"type":"System.String","value":{"$content":"Through
      the night, your men have <b>raised fresh fortifications</b> atop this hill.
      They are <color=#C9C9C9>rough</color>. They are <color=#C9C9C9>incomplete</color>.
      They are all that stand before the enemy now.\\n\\n<b><color=#B22222>The British
      are coming.</color></b>\\nTheir ranks are trained, their bayonets fixed, and
      their cannon will not spare this ground.\\n\\nYou command a <b><color=#FF5C5C>desperate
      defense</color></b>. <b>Hold the line.</b> Make every shot count.\\n\\nIf they
      take this hill, make them <b><color=#FF3B30>fear the price.</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":-94.0,"y":-169.0},"guid":"d4d7c6b1-f2a3-47cf-95cd-6c480d5b785a","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"243"},{"type":"System.String","value":{"$content":"GO
      TO","$type":"System.String"},"defaultValues":{},"position":{"x":-18.0,"y":1703.0},"guid":"8ec36103-7a1a-456e-9775-1c98a68eb07f","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"245"},{"argumentCount":1,"coroutine":false,"defaultValues":{"target":null,"name":{"$content":"Bunker
      Hill","$type":"System.String"}},"position":{"x":-1504.0,"y":460.0},"guid":"17cb7bd2-8b05-4002-86e8-58dc0f313936","$version":"A","$type":"Unity.VisualScripting.CustomEvent","$id":"247"},{"argumentCount":4,"defaultValues":{"name":{"$content":"Alert","$type":"System.String"},"target":null},"position":{"x":-984.0,"y":445.0},"guid":"2392e8b7-21a2-4dd9-b928-156543bbffc4","$version":"A","$type":"Unity.VisualScripting.TriggerCustomEvent","$id":"249"},{"type":"System.String","value":{"$content":"CLOSE","$type":"System.String"},"defaultValues":{},"position":{"x":-1257.0,"y":637.0},"guid":"ccec0417-33f9-43e0-8df3-b33550b6311e","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"251"},{"type":"System.String","value":{"$content":"<b><color=#D6B25E>Welcome,
      Commander!</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":-1245.0,"y":534.0},"guid":"e1cf470e-4297-4917-826b-4b06fffd613c","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"253"},{"type":"UnityEngine.Vector3","value":{"x":0.0,"y":0.0,"z":0.0,"$type":"UnityEngine.Vector3"},"defaultValues":{},"position":{"x":-1228.0,"y":766.0},"guid":"3d76588a-8408-414b-a74d-08e345780e7b","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"255"},{"type":"System.String","value":{"$content":"Through
      the night, your men have <b>raised fresh fortifications</b> atop this hill.
      They are <color=#C9C9C9>rough</color>. They are <color=#C9C9C9>incomplete</color>.
      They are all that stand before the enemy now.\\n\\n<b><color=#B22222>The British
      are coming.</color></b>\\nTheir ranks are trained, their bayonets fixed, and
      their cannon will not spare this ground.\\n\\nYou command a <b><color=#FF5C5C>desperate
      defense</color></b>. <b>Hold the line.</b> Make every shot count.\\n\\nIf they
      take this hill, make them <b><color=#FF3B30>fear the price.</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":-1246.0,"y":370.0},"guid":"73b52bb8-cafa-4698-b726-5d948cc59f6b","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"257"},{"sourceUnit":{"$ref":"167"},"sourceKey":"exit","destinationUnit":{"$ref":"233"},"destinationKey":"assign","guid":"9acca12c-8e37-4903-ba38-66c799536267","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"41"},"sourceKey":"trigger","destinationUnit":{"$ref":"57"},"destinationKey":"assign","guid":"061e247a-0853-4c34-b3a9-e2fb76c9687a","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"57"},"sourceKey":"assigned","destinationUnit":{"$ref":"21"},"destinationKey":"enter","guid":"839cb5fe-f2a4-4607-ab46-5b57a6bd4b2b","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"74"},"sourceKey":"assigned","destinationUnit":{"$ref":"127"},"destinationKey":"enter","guid":"55172928-8933-4756-8b01-69566d13608c","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"147"},"sourceKey":"assigned","destinationUnit":{"$ref":"39"},"destinationKey":"enter","guid":"3afb2973-8020-4ec3-a88e-bccc9392fad8","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"225"},"sourceKey":"trigger","destinationUnit":{"$ref":"141"},"destinationKey":"enter","guid":"8f417c48-857d-4dbd-a719-d5fb25ce2bb9","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"127"},"sourceKey":"exit","destinationUnit":{"$ref":"181"},"destinationKey":"enter","guid":"8b2e4a34-c73b-4445-87d3-928f11cdc7a7","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"235"},"sourceKey":"trigger","destinationUnit":{"$ref":"62"},"destinationKey":"enter","guid":"d1c80e7f-4ded-4112-9da6-7ee3c6dbdc27","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"121"},"sourceKey":"trigger","destinationUnit":{"$ref":"91"},"dest