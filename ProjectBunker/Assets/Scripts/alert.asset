      TO","$type":"System.String"},"defaultValues":{},"position":{"x":-12.0,"y":655.0},"guid":"ae6d8072-3fe5-4e51-971e-fa9de849d732","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"570"},{"chainable":false,"parameterNames":["value"],"member":{"name":"SetActive","parameterTypes":["System.Boolean"],"targetType":"UnityEngine.GameObject","targetTypeName":"UnityEngine.GameObject","$version":"A"},"defaultValues":{"target":null,"%value":{"$content":false,"$type":"System.Boolean"}},"position":{"x":-3267.0,"y":1750.0},"guid":"1c4c86ce-6ac8-479d-b807-ad84751d71a2","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"572"},{"specifyFallback":false,"kind":"Object","defaultValues":{"name":{"$content":"GUY","$type":"System.String"},"object":null},"position":{"x":-3481.0,"y":1606.0},"guid":"533c7857-599f-419e-b8df-c1c296e5f254","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"576"},{"chainable":false,"parameterNames":["value"],"member":{"name":"SetActive","parameterTypes":["System.Boolean"],"targetType":"UnityEngine.GameObject","targetTypeName":"UnityEngine.GameObject","$version":"A"},"defaultValues":{"target":null,"%value":{"$content":true,"$type":"System.Boolean"}},"position":{"x":-3658.0,"y":1752.0},"guid":"b4dd317f-5ca5-402e-9b98-c81743f0545d","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"578"},{"specifyFallback":false,"kind":"Object","defaultValues":{"name":{"$content":"GIF3","$type":"System.String"},"object":null},"position":{"x":-3254.0,"y":1593.0},"guid":"35fcc46e-6391-41c9-a3d0-65e2f011d1f6","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"582"},{"type":"System.String","value":{"$content":"You
      have selected a <b><color=#4DA6FF>player unit</color></b>, Commander.\\n\\nPress
      <b><color=#D6B25E>Q</color></b> to <b><color=#C9C9C9>disengage</color></b>
      and pull the unit out of combat.\\nPress <b><color=#D6B25E>E</color></b> to
      <b><color=#FF5C5C>engage</color></b> the enemy.\\nPress <b><color=#D6B25E>1</color></b>,
      <b><color=#D6B25E>2</color></b>, or <b><color=#D6B25E>3</color></b> to set
      firing range to <b><color=#4CAF50>Low</color></b>, <b><color=#4DA6FF>Medium</color></b>,
      or <b><color=#B22222>Far</color></b>.\\nUse <b><color=#D6B25E>Right Click</color></b>
      to <b>move</b> the unit.\\n\\n<b><color=#FF5C5C>The longer the range, the less
      damage your shots will do.</color></b>\\n\\nCommand carefully. A well-placed
      unit can hold the line. A poorly handled one will die for little.","$type":"System.String"},"defaultValues":{},"position":{"x":-24.0,"y":2869.0},"guid":"43cb68b5-36dc-4cbe-899a-84e38bcdc516","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"584"},{"type":"System.String","value":{"$content":"CLOSE","$type":"System.String"},"defaultValues":{},"position":{"x":-105.0,"y":98.0},"guid":"9b598b8b-e6c1-46da-a751-002bf23fb92c","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"586"},{"defaultValues":{"seconds":{"$content":5.0,"$type":"System.Single"},"unscaledTime":{"$content":false,"$type":"System.Boolean"}},"position":{"x":632.0,"y":-71.0},"guid":"a3944700-6d52-4a35-8c10-6c0243c93ba7","$version":"A","$type":"Unity.VisualScripting.WaitForSecondsUnit","$id":"588"},{"chainable":false,"parameterNames":["value"],"member":{"name":"SetActive","parameterTypes":["System.Boolean"],"targetType":"UnityEngine.GameObject","targetTypeName":"UnityEngine.GameObject","$version":"A"},"defaultValues":{"target":null,"%value":{"$content":true,"$type":"System.Boolean"}},"position":{"x":-3095.0,"y":1749.0},"guid":"3e32bfc1-ac95-461c-a5b0-4af5c431b92f","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"590"},{"type":"System.String","value":{"$content":"Next","$type":"System.String"},"defaultValues":{},"position":{"x":-2364.0,"y":3972.0},"guid":"f4d33f47-b9ea-43d8-bba9-d39eaf6de2cf","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"594"},{"type":"System.String","value":{"$content":"<b><color=#D6B25E>Welcome,
