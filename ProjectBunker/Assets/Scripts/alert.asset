      TO","$type":"System.String"},"defaultValues":{},"position":{"x":17.0,"y":1203.0},"guid":"8fd86bdd-edd9-4b76-8b2a-84e3caa9b6ff","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"205"},{"argumentCount":4,"defaultValues":{"name":{"$content":"Alert","$type":"System.String"},"target":null},"position":{"x":236.0,"y":1973.0},"guid":"b84de2c4-aebf-438d-a4f9-a0faba7254f4","$version":"A","$type":"Unity.VisualScripting.TriggerCustomEvent","$id":"207"},{"argumentCount":1,"coroutine":false,"defaultValues":{"target":null,"name":{"$content":"Morale","$type":"System.String"}},"position":{"x":-431.0,"y":461.0},"guid":"66077ed8-cf57-4d14-be0d-36b54cea3e14","$version":"A","$type":"Unity.VisualScripting.CustomEvent","$id":"209"},{"argumentCount":4,"defaultValues":{"name":{"$content":"Alert","$type":"System.String"},"target":null},"position":{"x":261.0,"y":463.0},"guid":"e10fe2bf-2623-4145-8f18-875f8da14a42","$version":"A","$type":"Unity.VisualScripting.TriggerCustomEvent","$id":"211"},{"kind":"Graph","defaultValues":{"name":{"$content":"Deadb","$type":"System.String"}},"position":{"x":420.0,"y":3815.0},"guid":"b01fe4db-0bfb-4e81-81cd-0a3f02572b61","$version":"A","$type":"Unity.VisualScripting.SetVariable","$id":"213"},{"defaultValues":{},"position":{"x":-134.0,"y":478.0},"guid":"61c1c303-ba47-45b4-885e-41ab24fbca63","$version":"A","$type":"Unity.VisualScripting.If","$id":"215"},{"kind":"Graph","defaultValues":{"name":{"$content":"HealthB","$type":"System.String"}},"position":{"x":461.0,"y":1525.0},"guid":"7caf491b-9901-4e4e-b6f2-4b4ed3a115a4","$version":"A","$type":"Unity.VisualScripting.SetVariable","$id":"217"},{"chainable":false,"parameterNames":["text"],"member":{"name":"SetText","parameterTypes":["System.String"],"targetType":"TMPTXT","targetTypeName":"TMPTXT","$version":"A"},"defaultValues":{"target":null,"%text":{"$content":"","$type":"System.String"}},"position":{"x":242.0,"y":-400.0},"guid":"ac0c8b31-2ca1-4261-99b1-f0b3f37d3576","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"219"},{"chainable":false,"parameterNames":["text"],"member":{"name":"SetText","parameterTypes":["System.String"],"targetType":"TMPTXT","targetTypeName":"TMPTXT","$version":"A"},"defaultValues":{"target":null,"%text":{"$content":"","$type":"System.String"}},"position":{"x":18.0,"y":-420.0},"guid":"806d53af-bcc0-4852-ad0e-4d87eb2374d4","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"223"},{"kind":"Graph","defaultValues":{"name":{"$content":"Click","$type":"System.String"}},"position":{"x":446.0,"y":2950.0},"guid":"e584b9af-4a98-42df-8cfa-668afcdb0092","$version":"A","$type":"Unity.VisualScripting.SetVariable","$id":"227"},{"specifyFallback":false,"kind":"Graph","defaultValues":{"name":{"$content":"Morale","$type":"System.String"}},"position":{"x":-190.0,"y":626.0},"guid":"a8c4ddaf-a85b-4d6a-8eba-d456a6d717ef","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"229"},{"argumentCount":1,"coroutine":false,"defaultValues":{"target":null,"name":{"$content":"Hill","$type":"System.String"}},"position":{"x":-409.0,"y":2532.0},"guid":"10c5c191-eef8-487a-a5a9-d2495d9f0ae0","$version":"A","$type":"Unity.VisualScripting.CustomEvent","$id":"231"},{"type":"System.String","value":{"$content":"The
      <b><color=#B22222>first British wave</color></b> is upon you, Commander. Their
      line advances through smoke and thunder, and the hill trembles beneath their
      approach.\\n\\nIf they <b><color=#FF5C5C>break through here</color></b>, fear
      will spread fast. If you <b><color=#4CAF50>throw them back</color></b>, your
      men may yet believe this line can hold.\\n\\n<b><color=#D6B25E>Stand firm</color></b>.
      Meet them with <b><color=#4DA6FF>disciplined fire</color></b>, and make the
      <b><color=#FF5C5C>first assault a costly one</color></b>.\\n\\n<b><color=#C9C9C9>This
      is only the beginning.</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":-28.0,"y":1906.0},"guid":"88f6a051-3e47-40a4-a849-bd4d5721d085","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"233"},{"type":"System.String","value":{"$content":"<b><color=#D6B25E>Welcome,
      Commander!</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":-1245.0,"y":534.0},"guid":"e1cf470e-4297-4917-826b-4b06fffd613c","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"235"},{"type":"System.Boolean","value":{"$content":false,"$type":"System.Boolean"},"defaultValues":{},"position":{"x":443.0,"y":2131.0},"guid":"cf58f438-8dee-4dbc-8fdc-98a8e7dd1987","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"237"},{"specifyFallback":false,"kind":"Graph","defaultValues":{"name":{"$content":"Click","$type":"System.String"}},"position":{"x":-211.0,"y":3099.0},"guid":"4b6a220e-1934-47f4-831e-677c9e162872","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"239"},{"type":"System.String","value":{"$content":"Through
      the night, your men have <b>raised fresh fortifications</b> atop this hill.
      They are <color=#C9C9C9>rough</color>. They are <color=#C9C9C9>incomplete</color>.
      They are all that stand before the enemy now.\\n\\n<b><color=#B22222>The British
      are coming.</color></b>\\nTheir ranks are trained, their bayonets fixed, and
      their cannon will not spare this ground.\\n\\nYou command a <b><color=#FF5C5C>desperate
      defense</color></b>. <b>Hold the line.</b> Make every shot count.\\n\\nIf they
      take this hill, make them <b><color=#FF3B30>fear the price.</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":-1246.0,"y":370.0},"guid":"73b52bb8-cafa-4698-b726-5d948cc59f6b","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"241"},{"type":"System.String","value":{"$content":"Through
      the night, your men have <b>raised fresh fortifications</b> atop this hill.
      They are <color=#C9C9C9>rough</color>. They are <color=#C9C9C9>incomplete</color>.
      They are all that stand before the enemy now.\\n\\n<b><color=#B22222>The British
      are coming.</color></b>\\nTheir ranks are trained, their bayonets fixed, and
      their cannon will not spare this ground.\\n\\nYou command a <b><color=#FF5C5C>desperate
      defense</color></b>. <b>Hold the line.</b> Make every shot count.\\n\\nIf they
      take this hill, make them <b><color=#FF3B30>fear the price.</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":-94.0,"y":-169.0},"guid":"d4d7c6b1-f2a3-47cf-95cd-6c480d5b785a","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"243"},{"type":"System.String","value":{"$content":"You
      have selected a <b><color=#4DA6FF>player unit</color></b>, Commander.\\n\\nPress
      <b><color=#D6B25E>Q</color></b> to <b><color=#C9C9C9>disengage</color></b>
      and pull the unit out of combat.\\nPress <b><color=#D6B25E>E</color></b> to
      <b><color=#FF5C5C>engage</color></b> the enemy.\\nPress <b><color=#D6B25E>1</color></b>,
      <b><color=#D6B25E>2</color></b>, or <b><color=#D6B25E>3</color></b> to set
      firing range to <b><color=#4CAF50>Low</color></b>, <b><color=#4DA6FF>Medium</color></b>,
      or <b><color=#B22222>Far</color></b>.\\nUse <b><color=#D6B25E>Right Click</color></b>
      to <b>move</b> the unit.\\n\\n<b><color=#FF5C5C>The longer the range, the less
      damage your shots will do.</color></b>\\n\\nCommand carefully. A well-placed
      unit can hold the line. A poorly handled one will die for little.","$type":"System.String"},"defaultValues":{},"position":{"x":-24.0,"y":2869.0},"guid":"43cb68b5-36dc-4cbe-899a-84e38bcdc516","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"245"},{"specifyFallback":false,"kind":"Graph","defaultValues":{"name":{"$content":"Welcome","$type":"System.String"}},"position":{"x":-283.0,"y":69.0},"guid":"d0a25969-a22a-4354-9cac-32fe70ce9f8f","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"247"},{"specifyFallback":false,"kind":"Object","defaultValues":{"name":{"$content":"TextTitle","$type":"System.String"},"object":null},"position":{"x":16.0,"y":-550.0},"guid":"70b9f67a-bf34-49e6-bdbd-9c5c64eb03e0","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"249"},{"type":"System.String","value":{"$content":"GO
      TO","$type":"System.String"},"defaultValues":{},"position":{"x":-37.0,"y":2165.0},"guid":"4c14cfb5-35dd-4af5-ae05-1036e86842fd","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"251"},{"type":"System.Boolean","value":{"$content":false,"$type":"System.Boolean"},"defaultValues":{},"position":{"x":468.0,"y":621.0},"guid":"7563874e-8726-4183-b07f-692f61264cd9","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"253"},{"type":"System.String","value":{"$content":"<b><color=#D6B25E>The
      First Wave</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":-25.0,"y":2062.0},"guid":"5d414fe5-0705-4ffb-860e-17c8f17da4f8","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"255"},{"type":"System.String","value":{"$content":"The
      <b><color=#B22222>British are climbing Bunker Hill</color></b> for the first
      time, Commander. On the slope, they are <b><color=#C9C9C9>exposed</color></b>,
      <b><color=#C9C9C9>slowed</color></b>, and easy targets.\\n\\nAs they advance
      uphill, they will take <b><color=#FF5C5C>much greater damage</color></b> under
      your fire.\\n\\n<b><color=#D6B25E>Use the high ground</color></b>. Let them
      climb into range, then <b><color=#FF5C5C>make them pay for every step</color></b>
      before they reach your line.\\n\\nWhile they fight uphill, <b><color=#4DA6FF>the
