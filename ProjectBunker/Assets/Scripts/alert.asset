      a hill slows a unit and makes it easier to hit. Use that wisely. The same danger
      that threatens your men can punish the British as well.","$type":"System.String"},"defaultValues":{},"position":{"x":1651.0,"y":3067.0},"guid":"dc16d977-2dfe-41e1-931b-b6ee39a2a2b0","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"318"},{"specifyFallback":false,"kind":"Object","defaultValues":{"name":{"$content":"GUY","$type":"System.String"},"object":null},"position":{"x":866.0,"y":2428.0},"guid":"0db178f4-625a-4f28-95e9-97eeb6f35817","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"320"},{"argumentCount":1,"coroutine":false,"defaultValues":{"target":null,"name":{"$content":"Click","$type":"System.String"}},"position":{"x":-422.0,"y":2942.0},"guid":"bd3ac7c5-d422-4cb8-a568-f25813120cc1","$version":"A","$type":"Unity.VisualScripting.CustomEvent","$id":"322"},{"chainable":false,"member":{"name":"timeScale","parameterTypes":null,"targetType":"UnityEngine.Time","targetTypeName":"UnityEngine.Time","$version":"A"},"defaultValues":{"input":{"$content":1.0,"$type":"System.Single"}},"position":{"x":1292.0,"y":-457.0},"guid":"3f2cc46f-e908-4d4c-9908-6bef58fbc3fe","$version":"A","$type":"Unity.VisualScripting.SetMember","$id":"324"},{"kind":"Graph","defaultValues":{"name":{"$content":"HillTop","$type":"System.String"}},"position":{"x":2121.0,"y":3148.0},"guid":"9873bbeb-701d-46ac-b23a-5988d7247837","$version":"A","$type":"Unity.VisualScripting.SetVariable","$id":"327"},{"chainable":false,"parameterNames":["value"],"member":{"name":"SetActive","parameterTypes":["System.Boolean"],"targetType":"UnityEngine.GameObject","targetTypeName":"UnityEngine.GameObject","$version":"A"},"defaultValues":{"target":null,"%value":{"$content":false,"$type":"System.Boolean"}},"position":{"x":682.0,"y":2552.0},"guid":"25a22412-33c5-433c-9c52-a1f7be9c8273","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"329"},{"chainable":false,"parameterNames":["value"],"member":{"name":"SetActive","parameterTypes":["System.Boolean"],"targetType":"UnityEngine.