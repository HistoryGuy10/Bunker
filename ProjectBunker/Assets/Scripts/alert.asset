      to the Colonial","$type":"System.String"},"defaultValues":{},"position":{"x":-2.0,"y":764.0},"guid":"20373516-c386-4190-a2b5-257c2976834e","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"67"},{"defaultValues":{},"position":{"x":-134.0,"y":478.0},"guid":"61c1c303-ba47-45b4-885e-41ab24fbca63","$version":"A","$type":"Unity.VisualScripting.If","$id":"69"},{"specifyFallback":false,"kind":"Graph","defaultValues":{"name":{"$content":"Morale","$type":"System.String"}},"position":{"x":-190.0,"y":626.0},"guid":"a8c4ddaf-a85b-4d6a-8eba-d456a6d717ef","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"71"},{"argumentCount":4,"defaultValues":{"name":{"$content":"Alert","$type":"System.String"},"target":null},"position":{"x":261.0,"y":463.0},"guid":"e10fe2bf-2623-4145-8f18-875f8da14a42","$version":"A","$type":"Unity.VisualScripting.TriggerCustomEvent","$id":"73"},{"type":"System.String","value":{"$content":"<b><color=#D6B25E>Fear
      in the Ranks</color></b>","$type":"System.String"},"defaultValues":{},"position":{"x":0.0,"y":552.0},"guid":"ab024443-3895-416e-b5ae-f1989dd81123","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"75"},{"type":"System.String","value":{"$content":"CLOSE","$type":"System.String"},"defaultValues":{},"position":{"x":-12.0,"y":655.0},"guid":"ae6d8072-3fe5-4e51-971e-fa9de849d732","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"77"},{"kind":"Graph","defaultValues":{"name":{"$content":"Morale","$type":"System.String"}},"position":{"x":467.0,"y":477.0},"guid":"f2c71b84-ed7d-465f-9f23-a9f87c2262d1","$version":"A","$type":"Unity.VisualScripting.SetVariable","$id":"79"},{"type":"System.Boolean","value":{"$content":false,"$type":"System.Boolean"},"defaultValues":{},"position":{"x":468.0,"y":621.0},"guid":"7563874e-8726-4183-b07f-692f61264cd9","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"81"},{"type":"System.String","value":{"$content":"Although
      the battle has just begun, small groups of men have already left you, shaken
      by the fear of the British landing.\\n\\nBritish cannon fire will continue
      to <b><color=#FF5C5C>drain morale</color></b> with every strike. If your troops
      lose <b><color=#FF5C5C>all morale</color></b>, they will <b><color=#B22222>break
      and flee the battle</color></b>.\\n\\nAt times, it may be wise to <b><color=#D6B25E>move
      your troops back from the main line</color></b>, so they can recover and <b><color=#4DA6FF>regain
      morale</color></b> before returning to the fight.\\n\\n<b><color=#4DA6FF>Watch
      the blue bar</color></b> to manage morale. If fear overtakes the line, this
      hill will be lost from within.","$type":"System.String"},"defaultValues":{},"position":{"x":-4.0,"y":379.0},"guid":"ca46c7c5-09cd-4817-a6ee-340b0fe621a4","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"83"},{"sourceUnit":{"$ref":"13"},"sourceKey":"trigger","destinationUnit":{"$ref":"28"},"destinationKey":"assign","guid":"c2a84329-d4fc-472e-b662-a779fe30e391","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"18"},"sourceKey":"exit","destinationUnit":{"$ref":"15"},"destinationKey":"assign","guid":"0d8661ec-f00e-4103-9e90-196c88fc5628","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"35"},"sourceKey":"ifTrue","destinationUnit":{"$ref":"39"},"destinationKey":"enter","guid":"328a287a-bdc9-4bcf-9428-64460aeeebb1","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"33"},"sourceKey":"trigger","destinationUnit":{"$ref":"35"},"destinationKey":"enter","guid":"2b8a570b-4b08-4794-8e6f-bac746813ef2","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"11"},"sourceKey":"trigger","destinationUnit":{"$ref":"49"},"destinationKey":"enter","guid":"9dbaa6ed-a0f1-4109-8996-a6279889cd7e","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"49"},"sourceKey":"exit","destinationUnit":{"$ref":"53"},"destinationKey":"enter","guid":"8b2e4a34-c73b-4445-87d3-928f11cdc7a7","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"57"},"sourceKey":"exit","destinationUnit":{"$ref":"18"},"destinationKey":"enter","guid":"455682e4-d741-4aab-bc7e-6f043e69d7c4","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"53"},"sourceKey":"exit","destinationUnit":{"$ref":"57"},"destinationKey":"enter","guid":"d4cb304a-55ae-497e-a414-4298b23f4433","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"39"},"sourceKey":"exit","destinationUnit":{"$ref":"61"},"destinationKey":"assign","guid":"92c2a42f-f41a-4b48-ac49-98191c03a483","